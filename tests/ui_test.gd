extends SceneTree

const World = preload("res://simulation/world.gd")

func _initialize() -> void:
	call_deferred("run_checks")

func run_checks() -> void:
	var us_reference = preload("res://ui/us_reference.gd")
	var us_data: Dictionary = us_reference.read()
	assert(us_reference.validate(us_data).is_empty())
	var bad_us: Dictionary = us_data.duplicate(true)
	bad_us.budget.functions[0].millions += 1000
	assert(not us_reference.validate(bad_us).is_empty())
	var federal_budget = preload("res://simulation/federal_budget.gd")
	var original_us: Dictionary = us_data.duplicate(true)
	var base: Dictionary = federal_budget.preview(us_data, "Health", 978878)
	assert(base.error.is_empty() and base.outlays_millions == 7009992 and base.deficit_millions == 1775375)
	var changed: Dictionary = federal_budget.preview(us_data, "Health", 988878)
	assert(changed.error.is_empty() and changed.outlays_millions == 7019992 and changed.deficit_millions == 1785375)
	assert(us_data == original_us)
	assert(not federal_budget.preview(us_data, "Undistributed Offsetting Receipts", 0).error.is_empty())
	assert(not federal_budget.preview(us_data, "Health", -1).error.is_empty())
	assert(not federal_budget.preview(us_data, "Missing", 1).error.is_empty())
	bad_us = us_data.duplicate(true)
	bad_us.budget.functions.append(bad_us.budget.functions[0].duplicate(true))
	assert(not us_reference.validate(bad_us).is_empty())
	assert(ProjectSettings.get_setting("display/window/size/mode") == 2)
	var catalog = preload("res://ui/law_catalog_data.gd")
	var catalog_data: Dictionary = catalog.read()
	assert(catalog.validate(catalog_data).is_empty())
	assert(catalog_data.categories.size() == 21 and catalog_data.laws.size() == 254)
	for category in catalog_data.categories:
		assert(catalog_data.laws.any(func(law): return law.category == category))
	var bad_catalog: Dictionary = catalog_data.duplicate(true)
	bad_catalog.laws.append(bad_catalog.laws[0].duplicate(true))
	assert(not catalog.validate(bad_catalog).is_empty())
	bad_catalog = catalog_data.duplicate(true)
	bad_catalog.laws[0].id = "unimplemented_law"
	assert(not catalog.validate(bad_catalog).is_empty())
	bad_catalog = catalog_data.duplicate(true)
	bad_catalog.laws[0].category = "Tax"
	assert(not catalog.validate(bad_catalog).is_empty())
	bad_catalog = catalog_data.duplicate(true)
	bad_catalog.laws[0].keywords = [42]
	assert(not catalog.validate(bad_catalog).is_empty())
	var main_script = preload("res://ui/main.gd")
	assert(main_script._canvas_size_for_window(Vector2i(2940, 1700)) == Vector2i(1152, 648))
	assert(main_script._canvas_size_for_window(Vector2i(1152, 720)) == Vector2i(576, 360))
	assert(main_script._canvas_size_for_window(Vector2i(0, 0)) == Vector2i(1152, 648))
	assert(main_script._canvas_size_for_window(Vector2i(1200, 600), 1.5) == Vector2i(800, 400))
	assert(main_script._canvas_size_for_window(Vector2i(1200, 600), 2.5) == Vector2i(480, 240))
	var settings_path := "res://tests/ui_preferences_test.cfg"
	assert(not FileAccess.file_exists(settings_path))
	assert(main_script._read_ui_size(settings_path) == 1)
	assert(main_script._write_ui_size(settings_path, 2).is_empty())
	assert(main_script._read_ui_size(settings_path) == 2)
	assert(not main_script._write_ui_size(settings_path, 7).is_empty())
	assert(main_script._read_ui_size(settings_path) == 2)
	DirAccess.remove_absolute(ProjectSettings.globalize_path(settings_path))
	var malformed := FileAccess.open(settings_path, FileAccess.WRITE)
	malformed.store_string("[display]\nsmall_window_size=99\n")
	malformed.close()
	assert(main_script._read_ui_size(settings_path) == 1)
	assert(main_script._write_ui_size(settings_path, 0).is_empty())
	assert(main_script._read_ui_size(settings_path) == 0)
	DirAccess.remove_absolute(ProjectSettings.globalize_path(settings_path))
	var screen = load("res://main.tscn").instantiate()
	root.add_child(screen)
	screen.set_process(false)
	assert(screen.dashboard_tabs.get_tab_count() == 12)
	assert(screen.find_child("USReferenceTable", true, false) != null)
	var budget_preview: Label = screen.find_child("USBudgetPreview", true, false)
	assert("7009992" in budget_preview.text)
	var budget_amount: SpinBox = screen.find_child("USBudgetAmount", true, false)
	budget_amount.value += 10000
	assert("7019992" in budget_preview.text)
	assert("1 sample ·" in screen.indicator_summary.text and screen.indicator_chart.metric == "approval")
	screen.indicator_picker.select(1)
	screen._refresh_indicators()
	assert(screen.indicator_chart.metric == "deficit" and "M USD" in screen.indicator_summary.text)
	screen.indicator_picker.select(5)
	screen._refresh_indicators()
	assert(screen.indicator_chart.metric == "population" and "10000000 people" in screen.indicator_summary.text)
	var chart_samples: Array = screen.world.indicator_history.duplicate(true)
	screen.world.indicator_history[0].erase("population")
	screen._refresh_indicators()
	assert(screen.indicator_chart.samples.is_empty() and "not invented" in screen.indicator_summary.text)
	screen.world.indicator_history = chart_samples
	screen.indicator_picker.select(0)
	screen._refresh_indicators()
	var fiscal_original: Dictionary = screen.world.export_snapshot()
	screen.tax.value = 25.0
	var found_tax_review := false
	for button in screen.find_children("*", "Button", true, false):
		if button.text == "Review income tax":
			button.pressed.emit()
			found_tax_review = true
			break
	assert(found_tax_review and screen.pending_decision.id == "set_income_tax" and screen.world.export_snapshot() == fiscal_original)
	screen._cancel_review()
	screen.review_dialog.hide()
	assert(screen._request_review("set_income_tax", {"rate": 0.3}))
	assert("National approval" in screen.review_dialog.dialog_text and screen.world.export_snapshot() == fiscal_original)
	screen._cancel_review()
	screen.review_dialog.hide()
	assert(screen.world.export_snapshot() == fiscal_original)
	assert(screen._request_review("set_income_tax", {"rate": 0.3}))
	screen.world.advance_day()
	screen._confirm_review()
	screen.review_dialog.hide()
	assert("State changed" in screen.status.text and screen.world.country.income_tax_rate == 0.2)
	assert(screen._request_review("set_income_tax", {"rate": 0.3}))
	screen._confirm_review()
	screen.review_dialog.hide()
	assert(is_equal_approx(screen.world.country.income_tax_rate, 0.3))
	assert(screen._request_review("set_additional_tax", {"kind": "corporate", "rate": 0.1}))
	screen._confirm_review()
	screen.review_dialog.hide()
	assert(is_equal_approx(screen.world.country.corporate_tax_rate, 0.1))
	assert(screen._request_review("set_total_spending", {"amount": 1000000000.0}))
	assert("resets every category" in screen.review_dialog.dialog_text)
	screen._confirm_review()
	screen.review_dialog.hide()
	assert(is_equal_approx(screen.world.country.annual_spending, 1000000000.0))
	assert(screen._request_review("set_category_spending", {"category": "Health", "amount": 400000000.0}))
	screen._confirm_review()
	screen.review_dialog.hide()
	assert(is_equal_approx(screen.world.country.spending_categories.Health, 400000000.0))
	assert(not screen._request_review("set_category_spending", {"category": "Health", "amount": 20000000000.0}))
	assert(screen.world.import_snapshot(fiscal_original).is_empty())
	screen._sync_loaded_world("Test reset.")
	assert(screen.dashboard_tabs.get_tab_title(9) == "Executive Orders")
	assert(screen.dashboard_tabs.get_tab_title(10) == "World Lab" and screen.world_lab.initialized)
	var single_country_before_lab: Dictionary = screen.world.export_snapshot()
	screen.world_lab.advance_day()
	assert(screen.world.export_snapshot() == single_country_before_lab)
	assert(screen.world_lab.registry.country_snapshot("usa_sandbox").date.day == 13)
	screen.world_lab._action("batch")
	while screen.world_lab.batch_remaining > 0:
		screen.world_lab._process(0.0)
	assert(screen.world.export_snapshot() == single_country_before_lab)
	assert(screen.world_lab.registry.country_snapshot("usa_sandbox").date == screen.world_lab.registry.country_snapshot("coastal_republic").date)
	var selected_lab_id: String = screen.world_lab.selected_id()
	var lab_before_handoff: Dictionary = screen.world_lab.registry.export_snapshot()
	screen.running = true
	screen.world_lab.running = true
	screen._request_lab_handoff(selected_lab_id)
	assert(not screen.running and not screen.world_lab.running and not screen.pending_lab_handoff.is_empty())
	assert("Neither save file is written" in screen.lab_handoff_dialog.dialog_text)
	screen._cancel_lab_handoff()
	screen.lab_handoff_dialog.hide()
	assert(screen.world.export_snapshot() == single_country_before_lab and screen.world_lab.registry.export_snapshot() == lab_before_handoff)
	screen._request_lab_handoff(selected_lab_id)
	screen.world_lab.advance_day()
	screen._confirm_lab_handoff()
	screen.lab_handoff_dialog.hide()
	assert("out of date" in screen.status.text and screen.world.export_snapshot() == single_country_before_lab)
	screen._request_lab_handoff(selected_lab_id)
	screen.world.advance_day()
	var changed_main: Dictionary = screen.world.export_snapshot()
	screen._confirm_lab_handoff()
	screen.lab_handoff_dialog.hide()
	assert("out of date" in screen.status.text and screen.world.export_snapshot() == changed_main)
	var lab_copy_before: Dictionary = screen.world_lab.registry.export_snapshot()
	screen._request_lab_handoff(selected_lab_id)
	screen._confirm_lab_handoff()
	screen.lab_handoff_dialog.hide()
	assert(screen.world.country.id == selected_lab_id and screen.world.date == screen.world_lab.registry.country_snapshot(selected_lab_id).date)
	assert(screen.dashboard_tabs.current_tab == 0 and screen.world_lab.registry.export_snapshot() == lab_copy_before)
	assert(screen.world.set_income_tax(0.6))
	assert(screen.world_lab.registry.export_snapshot() == lab_copy_before)
	assert(screen._start_scenario(World.DEFAULT_SCENARIO))
	assert(screen.world_lab.copy_from_main_button.disabled)
	assert(not screen.world_lab.build_from_main(screen.world.export_snapshot()).error.is_empty())
	assert(screen._start_scenario("res://data/scenarios/usa_sandbox.json"))
	assert(not screen.world_lab.copy_from_main_button.disabled)
	assert(screen.world.set_income_tax(0.3))
	screen.world.advance_day()
	screen._refresh()
	var main_before_migration: Dictionary = screen.world.export_snapshot()
	var old_lab: Dictionary = screen.world_lab.registry.export_snapshot()
	screen.running = true
	screen.world_lab.running = true
	screen._request_main_to_lab()
	assert(not screen.running and not screen.world_lab.running and not screen.pending_main_to_lab.is_empty())
	assert("Neither save file is written" in screen.main_to_lab_dialog.dialog_text)
	screen._cancel_main_to_lab()
	screen.main_to_lab_dialog.hide()
	assert(screen.world.export_snapshot() == main_before_migration and screen.world_lab.registry.export_snapshot() == old_lab)
	screen._request_main_to_lab()
	screen.world_lab.advance_day()
	var changed_lab: Dictionary = screen.world_lab.registry.export_snapshot()
	screen._confirm_main_to_lab()
	screen.main_to_lab_dialog.hide()
	assert("out of date" in screen.status.text and screen.world_lab.registry.export_snapshot() == changed_lab)
	screen._request_main_to_lab()
	screen.world.advance_day()
	var changed_main_for_migration: Dictionary = screen.world.export_snapshot()
	screen._confirm_main_to_lab()
	screen.main_to_lab_dialog.hide()
	assert("out of date" in screen.status.text and screen.world.export_snapshot() == changed_main_for_migration)
	screen._request_main_to_lab()
	var invalid_proposed: Dictionary = screen.pending_main_to_lab.proposed.duplicate(true)
	invalid_proposed.countries.usa_sandbox.country.treasury = -1.0
	assert(not screen.world_lab.replace_world(invalid_proposed).is_empty() and screen.world_lab.registry.export_snapshot() == changed_lab)
	screen._confirm_main_to_lab()
	screen.main_to_lab_dialog.hide()
	assert(screen.dashboard_tabs.current_tab == 10 and screen.world.export_snapshot() == changed_main_for_migration)
	var migrated_us: Dictionary = screen.world_lab.registry.country_snapshot("usa_sandbox")
	var migrated_coast: Dictionary = screen.world_lab.registry.country_snapshot("coastal_republic")
	assert(migrated_us == changed_main_for_migration and migrated_coast.date == migrated_us.date)
	assert(migrated_coast.fiscal.partial and screen.world_lab.registry.relationship("usa_sandbox", "coastal_republic") == 0.0)
	screen.world_lab.advance_day()
	assert(screen.world.export_snapshot() == changed_main_for_migration)
	assert(screen._start_scenario(World.DEFAULT_SCENARIO))
	# Shared mode uses one live country object and one authoritative clock.
	var shared_id: String = screen.world_lab.selected_id()
	var main_before_shared: Dictionary = screen.world.export_snapshot()
	var lab_before_shared: Dictionary = screen.world_lab.registry.export_snapshot()
	screen._request_shared_entry(shared_id)
	assert(not screen.pending_shared_entry.is_empty() and "Neither save is written" in screen.shared_entry_dialog.dialog_text)
	screen.pending_shared_entry.clear()
	screen.shared_entry_dialog.hide()
	assert(not screen.shared_world_active and screen.world.export_snapshot() == main_before_shared and screen.world_lab.registry.export_snapshot() == lab_before_shared)
	screen._request_shared_entry(shared_id)
	screen.world_lab.advance_day()
	screen._confirm_shared_entry()
	screen.shared_entry_dialog.hide()
	assert(not screen.shared_world_active and "out of date" in screen.status.text)
	screen._request_shared_entry(shared_id)
	screen._confirm_shared_entry()
	screen.shared_entry_dialog.hide()
	assert(screen.shared_world_active and screen.world_lab.shared_mode and screen.world == screen.world_lab.registry.controlled_country(shared_id))
	assert("assumed annual rates per 1,000" in screen.population_summary.text and "sum to the country population" in screen.population_summary.text)
	assert(screen._request_review("set_income_tax", {"rate": 0.22}))
	screen._confirm_review()
	screen.review_dialog.hide()
	assert(is_equal_approx(screen.world_lab.registry.country_snapshot(shared_id).country.income_tax_rate, 0.22))
	assert(is_equal_approx(screen.world_lab.tax.value, 22.0))
	assert(screen.shared_map_panel.visible and screen.shared_diplomacy_note.visible and not screen.diplomacy_picker.visible)
	screen.map_inspector_view = false
	screen._apply_map_layout(true)
	assert(screen.map_navigation.visible and screen.world_map.visible and not screen.map_inspector_scroll.visible)
	screen.map_inspector_view = true
	screen._apply_map_layout(true)
	assert(not screen.world_map.visible and screen.map_inspector_scroll.visible and screen.map_back_button.visible)
	assert(screen.map_inspector_button.button_pressed and not screen.map_controls.visible)
	screen._apply_map_layout(false)
	assert(screen.world_map.visible and screen.map_inspector_scroll.visible and not screen.map_navigation.visible)
	screen.map_inspector_view = false
	screen._update_map_layout()
	screen._select_shared_map_country("USA")
	assert(screen._shared_partner_id() == "usa_sandbox")
	assert(screen.shared_country_overview.visible and screen.shared_country_rows.Population.text == str(screen.world_lab.registry.country_snapshot("usa_sandbox").country.population))
	assert(screen.inspector_buttons.size() == 4 and screen.inspector_sections[0].visible and not screen.inspector_sections[1].visible)
	for section in range(4):
		screen._set_inspector_section(section)
		for index in range(4):
			assert(screen.inspector_sections[index].visible == (index == section))
	assert(("YOUR GOVERNMENT" if shared_id == "usa_sandbox" else "OTHER SIMULATED COUNTRY") in screen.shared_country_heading.text)
	for country in screen.world_map.countries:
		if country.id == "USA":
			screen.world_map.focus_country(country)
			break
	screen.map_inspector_view = true
	screen._apply_map_layout(true)
	assert(screen.world_map.selected_id == "USA" and screen.map_inspector_scroll.visible)
	screen.map_inspector_view = false
	screen._apply_map_layout(true)
	assert(screen.world_map.selected_id == "USA" and screen.world_map.visible)
	screen._update_map_layout()
	for index in range(screen.shared_partner_picker.item_count):
		if screen.shared_partner_picker.get_item_metadata(index) == "coastal_republic":
			screen.shared_partner_picker.select(index)
	screen._shared_country_picker_changed(screen.shared_partner_picker.selected)
	assert(screen.world_map.selected_id.is_empty() and screen._shared_partner_id() == "coastal_republic")
	assert("no map location" in screen.shared_country_heading.text)
	screen._select_shared_map_country("FRA")
	assert(screen._shared_partner_id().is_empty() and screen.shared_talk_button.disabled and not screen.shared_country_overview.visible)
	assert(screen.inspector_reference.visible and "REFERENCE ONLY" in screen.inspector_reference.text)
	screen._set_inspector_section(2)
	assert("economic data" in screen.inspector_reference.text)
	var other_id := "usa_sandbox" if shared_id == "coastal_republic" else "coastal_republic"
	for index in range(screen.shared_partner_picker.item_count):
		if screen.shared_partner_picker.get_item_metadata(index) == other_id:
			screen.shared_partner_picker.select(index)
	screen._refresh_shared_diplomacy()
	assert(not screen.shared_talk_button.disabled and "Relations:" in screen.shared_diplomacy_details.text)
	assert("OTHER SIMULATED COUNTRY" in screen.shared_country_heading.text)
	assert(screen.shared_country_rows.Approval.text == "%.1f%%" % screen.world_lab.registry.country_snapshot(other_id).country.approval)
	screen._request_shared_talk()
	assert(not screen.pending_shared_talk.is_empty())
	screen.pending_shared_talk.clear()
	screen.shared_talk_dialog.hide()
	assert(screen.world_lab.registry.dialogue_progress(shared_id, other_id) == -1)
	screen._request_shared_talk()
	screen.world_lab.registry.execute_country(other_id, {"id": "set_income_tax", "args": {"rate": 0.2}})
	screen._confirm_shared_talk()
	screen.shared_talk_dialog.hide()
	assert("out of date" in screen.status.text and screen.world_lab.registry.dialogue_progress(shared_id, other_id) == -1)
	screen._refresh()
	assert(screen.shared_country_rows["Income tax"].text == "20.0%")
	screen._request_shared_talk()
	screen._confirm_shared_talk()
	screen.shared_talk_dialog.hide()
	assert(screen.world_lab.registry.dialogue_progress(shared_id, other_id) == 0 and "day 0" in screen.world_lab.overview.text)
	assert("day 0/30" in screen.shared_country_rows.Diplomacy.text)
	screen._cancel_shared_talk()
	assert(screen.world_lab.registry.dialogue_progress(shared_id, other_id) == -1)
	assert(screen.main_save_button.text == "Save shared world" and screen.main_load_button.disabled and screen.scenario_start_button.disabled)
	assert(screen.world_lab.clock_buttons.advance.disabled and screen.world_lab.lab_buttons.load.disabled)
	var before_lab_clock: Dictionary = screen.world_lab.registry.export_snapshot()
	screen.world_lab._action("toggle")
	screen.world_lab._process(30.0)
	assert(not screen.world_lab.running and screen.world_lab.registry.export_snapshot() == before_lab_clock)
	var shared_us_day: Dictionary = screen.world_lab.registry.country_snapshot("usa_sandbox").date
	var shared_coast_day: Dictionary = screen.world_lab.registry.country_snapshot("coastal_republic").date
	screen._advance_day()
	assert(screen.world_lab.registry.country_snapshot("usa_sandbox").date == screen.world_lab.registry.country_snapshot("coastal_republic").date)
	assert(screen.world_lab.registry.country_snapshot("usa_sandbox").date != shared_us_day and shared_us_day == shared_coast_day)
	screen.tax.value = 60
	screen._apply_tax()
	assert(screen.world_lab.registry.country_snapshot(shared_id).country.income_tax_rate == 0.6)
	assert(screen.world_lab.tax.value == 60.0)
	screen.world_lab.tax.value = 30
	screen.world_lab.apply_tax()
	assert(screen.world.country.income_tax_rate == 0.3 and screen.tax.value == 30.0 and "Approval" in screen.government_status.text)
	var target_id := "usa_sandbox" if shared_id == "coastal_republic" else "coastal_republic"
	for index in range(screen.world_lab.picker.item_count):
		if screen.world_lab.picker.get_item_metadata(index) == target_id:
			screen.world_lab.picker.select(index)
	screen.world_lab._selection_changed()
	assert(screen.world.country.id == shared_id and not screen.world_lab.shared_buttons.switch.disabled)
	var before_switch: Dictionary = screen.world_lab.registry.export_snapshot()
	screen._request_shared_switch(target_id)
	assert(not screen.pending_shared_switch.is_empty() and "No save file is written" in screen.shared_switch_dialog.dialog_text)
	screen.pending_shared_switch.clear()
	screen.shared_switch_dialog.hide()
	assert(screen.world.country.id == shared_id and screen.world_lab.registry.export_snapshot() == before_switch)
	screen._request_shared_switch(target_id)
	screen.world_lab.registry.execute_country(target_id, {"id": "set_income_tax", "args": {"rate": 0.25}})
	screen._confirm_shared_switch()
	screen.shared_switch_dialog.hide()
	assert(screen.world.country.id == shared_id and "out of date" in screen.status.text)
	var switch_state: Dictionary = screen.world_lab.registry.export_snapshot()
	screen._request_shared_switch(target_id)
	screen._confirm_shared_switch()
	screen.shared_switch_dialog.hide()
	assert(screen.world.country.id == target_id and screen.world == screen.world_lab.registry.controlled_country(target_id))
	assert(screen.world_lab.shared_controlled_id == target_id and screen.world_lab.shared_buttons.switch.disabled)
	assert("YOUR GOVERNMENT" in screen.shared_country_heading.text)
	assert(screen.tax.value == 25.0 and screen.world_lab.registry.export_snapshot() == switch_state)
	screen.tax.value = 35
	screen._apply_tax()
	assert(screen.world_lab.registry.country_snapshot(target_id).country.income_tax_rate == 0.35)
	assert(screen.world_lab.registry.country_snapshot(shared_id).country.income_tax_rate == 0.3)
	for index in range(screen.shared_partner_picker.item_count):
		if screen.shared_partner_picker.get_item_metadata(index) == shared_id:
			screen.shared_partner_picker.select(index)
	screen._refresh_shared_diplomacy()
	screen._request_shared_talk()
	screen._confirm_shared_talk()
	screen.shared_talk_dialog.hide()
	for day in range(30):
		screen._advance_world_tick()
	screen._refresh()
	assert(screen.world_lab.registry.dialogue_progress("usa_sandbox", "coastal_republic") == -1)
	assert(screen.world_lab.registry.relationship("usa_sandbox", "coastal_republic") == 5.0)
	assert("Relations: 5.0" in screen.shared_diplomacy_details.text)
	assert(screen.shared_country_rows.Diplomacy.text == "None active")
	screen.shared_proposal_picker.select(1)
	screen._refresh_shared_diplomacy()
	assert("Conditions are checked at completion" in screen.shared_diplomacy_details.text and not screen.shared_talk_button.disabled)
	screen._request_shared_talk()
	screen._confirm_shared_talk()
	screen.shared_talk_dialog.hide()
	assert(screen.world_lab.registry.talk_kind(shared_id, target_id) == "cooperation")
	screen._cancel_shared_talk()
	screen.shared_proposal_picker.select(0)
	assert(screen.world.date == screen.world_lab.registry.country_snapshot("usa_sandbox").date)
	var before_blocked_load: Dictionary = screen.world_lab.registry.export_snapshot()
	screen._load_from("res://tests/nonexistent.json")
	assert(not screen._start_scenario(World.DEFAULT_SCENARIO) and screen.world_lab.registry.export_snapshot() == before_blocked_load)
