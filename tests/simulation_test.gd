	assert(recovered_backup.load_game(save_path + ".bak").is_empty())
	assert(is_equal_approx(recovered_backup.country.income_tax_rate, 0.60))
	var recovered_primary = World.new()
	assert(recovered_primary.load_game(save_path).is_empty())
	assert(FileAccess.file_exists(save_path + ".invalid"))
	# An interrupted rotation artifact must not be silently overwritten.
	var interrupted := FileAccess.open(save_path + ".bak.previous", FileAccess.WRITE)
	interrupted.store_string("preserve me")
	interrupted.close()
	assert(not restored.save_game(save_path).is_empty())
	assert(FileAccess.get_file_as_string(save_path + ".bak.previous") == "preserve me")
	assert(not FileAccess.file_exists(save_path + ".tmp"))
	assert(recovered_backup.load_game(save_path + ".bak").is_empty())
	var pending := FileAccess.open(save_path + ".tmp", FileAccess.WRITE)
	pending.store_string("interrupted temporary save")
	pending.close()
	assert(not restored.save_game(save_path).is_empty())
	assert(FileAccess.get_file_as_string(save_path + ".tmp") == "interrupted temporary save")
	assert(recovered_primary.load_game(save_path).is_empty())
	assert(recovered_backup.load_game(save_path + ".bak").is_empty())
	DirAccess.remove_absolute(ProjectSettings.globalize_path(save_path + ".tmp"))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(save_path + ".bak.previous"))
	# A directory at the destination forces the backup rename to fail on the
	# real filesystem. Neither valid save may be lost, and our temp is removed.
	assert(DirAccess.make_dir_absolute(ProjectSettings.globalize_path(save_path + ".bak.previous")) == OK)
	assert(not restored.save_game(save_path).is_empty())
	assert(recovered_primary.load_game(save_path).is_empty())
	assert(recovered_backup.load_game(save_path + ".bak").is_empty())
	assert(not FileAccess.file_exists(save_path + ".tmp"))
	assert(DirAccess.remove_absolute(ProjectSettings.globalize_path(save_path + ".bak.previous")) == OK)
	DirAccess.remove_absolute(ProjectSettings.globalize_path(save_path))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(save_path + ".bak"))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(save_path + ".invalid"))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(save_path + ".bak.previous"))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(save_path + ".tmp"))
	print("Simulation checks passed")
	quit(0)
