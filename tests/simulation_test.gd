extends SceneTree

const World = preload("res://simulation/world.gd")

func _initialize() -> void:
	var world = World.new()
	var initial_treasury: float = world.country.treasury
	var forecast: Dictionary = world.forecast_fiscal(365)
	assert(not forecast.is_empty() and world.date == World.INITIAL_DATE)
	assert(world.fiscal.days == 0 and world.politics.election_count == 0)
	assert(world.forecast_fiscal(0).is_empty() and world.forecast_fiscal(367).is_empty())
	for i in range(365):
		world.advance_day()
	assert(absf(forecast.cash - world.country.treasury) < 0.01)
	assert(absf(forecast.revenue - world.previous_fiscal.revenue) < 0.01)
	assert(forecast.end_date == world.date)
	assert(world.date == {"year": 2027, "month": 1, "day": 1})
	assert(absf(world.country.treasury - initial_treasury - 100000000.0) < 1.0)
	assert(world.previous_fiscal.days == 365 and world.fiscal.days == 0)
	assert(absf(world.previous_fiscal.revenue - 1200000000.0) < 1.0)
	assert(absf(world.previous_fiscal.spending - 1100000000.0) < 1.0)
	assert(not world.previous_fiscal.partial)
	var ledger_world = World.new()
	ledger_world.country.treasury = 0.0
	assert(ledger_world.set_annual_spending(2000000000.0))
	ledger_world.advance_day()
	assert(ledger_world.fiscal.borrowed > 0.0)
	var deficit_forecast: Dictionary = ledger_world.forecast_fiscal(30)
	assert(deficit_forecast.first_cash_exhaustion_day == 1 and deficit_forecast.debt > ledger_world.country.debt)
	assert(is_equal_approx(ledger_world.country.debt, ledger_world.fiscal.borrowed))
	assert(ledger_world.set_annual_spending(0.0))
	ledger_world.advance_day()
	assert(ledger_world.fiscal.interest > 0.0 and ledger_world.fiscal.repaid > 0.0)
	var accounting_balance: float = ledger_world.fiscal.revenue - ledger_world.fiscal.spending - ledger_world.fiscal.policy - ledger_world.fiscal.interest
	assert(absf(ledger_world.country.treasury - ledger_world.country.debt - accounting_balance) < 0.01)
	var ledger_path := "res://tests/fiscal_test.json"
	assert(ledger_world.save_game(ledger_path).is_empty())
	var ledger_loaded = World.new()
	assert(ledger_loaded.load_game(ledger_path).is_empty())
	assert(ledger_loaded.fiscal.days == ledger_world.fiscal.days)
	assert(is_equal_approx(ledger_loaded.fiscal.revenue, ledger_world.fiscal.revenue))
	assert(is_equal_approx(ledger_loaded.fiscal.borrowed, ledger_world.fiscal.borrowed))
	ledger_loaded.advance_day()
	ledger_world.advance_day()
	assert(ledger_loaded.fiscal.days == ledger_world.fiscal.days)
	assert(is_equal_approx(ledger_loaded.fiscal.interest, ledger_world.fiscal.interest))
	var ledger_file := FileAccess.open(ledger_path, FileAccess.READ)
	var ledger_data: Dictionary = JSON.parse_string(ledger_file.get_as_text())
	ledger_file.close()
	ledger_data.fiscal.interest = -1.0
	ledger_file = FileAccess.open(ledger_path, FileAccess.WRITE)
	ledger_file.store_string(JSON.stringify(ledger_data))
	ledger_file.close()
	assert(not ledger_loaded.load_game(ledger_path).is_empty())
	ledger_data.version = 7
	ledger_file = FileAccess.open(ledger_path, FileAccess.WRITE)
	ledger_file.store_string(JSON.stringify(ledger_data))
	ledger_file.close()
	assert(ledger_loaded.load_game(ledger_path).is_empty())
	assert(ledger_loaded.fiscal.partial and ledger_loaded.fiscal.days == 0)
	DirAccess.remove_absolute(ProjectSettings.globalize_path(ledger_path))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(ledger_path + ".bak"))
	assert(world.set_income_tax(0.25))
	assert(is_equal_approx(world.country.annual_revenue, 1300000000.0))
	assert(is_equal_approx(world.income_tax_revenue(), 500000000.0))
	assert(is_equal_approx(world.country.approval, 44.75))
	assert(not world.set_income_tax(-0.1))
	assert(not world.set_income_tax(NAN))
	assert(is_equal_approx(world.country.income_tax_rate, 0.25))
	var high_tax_world = World.new()
	var before_preview: Dictionary = high_tax_world.country.duplicate(true)
	var before_politics: Dictionary = high_tax_world.politics.export_state()
	var prediction: Dictionary = high_tax_world.preview_income_tax(0.60)
	assert(high_tax_world.country == before_preview)
	assert(high_tax_world.politics.export_state() == before_politics)
	assert(high_tax_world.preview_income_tax(NAN).is_empty())
	assert(high_tax_world.set_income_tax(0.60))
	assert(is_equal_approx(prediction.approval, high_tax_world.country.approval))
	assert(is_equal_approx(prediction.annual_revenue, high_tax_world.country.annual_revenue))
	assert(prediction.groups == high_tax_world.politics.groups)
	assert(is_equal_approx(high_tax_world.country.approval, 8.0))
	var tax_world = World.new()
	var tax_snapshot: Dictionary = tax_world.country.duplicate(true)
	var tax_politics_snapshot: Dictionary = tax_world.politics.export_state()
	var consumption_preview: Dictionary = tax_world.preview_additional_tax("consumption", 0.10)
	assert(tax_world.country == tax_snapshot)
	assert(tax_world.politics.export_state() == tax_politics_snapshot)
	assert(is_equal_approx(consumption_preview.annual_revenue, 1350000000.0))
	assert(not tax_world.set_additional_tax("unknown", 0.10))
	assert(not tax_world.set_additional_tax("corporate", NAN))
	assert(not tax_world.set_additional_tax("corporate", 0.61))
	assert(tax_world.set_additional_tax("consumption", 0.10))
	assert(is_equal_approx(tax_world.country.approval, consumption_preview.approval))
	assert(is_equal_approx(tax_world.additional_tax_revenue("consumption"), 150000000.0))
	assert(tax_world.politics.groups[0].approval < tax_world.politics.groups[2].approval)
	var corporate_preview: Dictionary = tax_world.preview_additional_tax("corporate", 0.20)
	assert(tax_world.set_additional_tax("corporate", 0.20))
	assert(is_equal_approx(tax_world.country.annual_revenue, 1550000000.0))
	assert(is_equal_approx(tax_world.country.approval, corporate_preview.approval))
	assert(is_equal_approx(tax_world.additional_tax_revenue("corporate"), 200000000.0))
	assert(high_tax_world.politics.groups[0].approval > high_tax_world.politics.groups[2].approval)
	var cycle = World.new()
	cycle.country.income_tax_rate = 0.60
	cycle.country.approval = 80.0
	for group in cycle.politics.groups:
		group.approval = 80.0
		group.raw_approval = 80.0
	assert(cycle.set_income_tax(0.0))
	assert(is_equal_approx(cycle.country.approval, 100.0))
	assert(cycle.set_income_tax(0.60))
	assert(is_equal_approx(cycle.country.approval, 80.0))
	var government = World.new()
	var lawful = World.new()
	assert(not lawful.issue_directive("unknown"))
	assert(lawful.issue_directive("reporting"))
	assert(not lawful.issue_directive("override"))
	for i in range(30):
		lawful.advance_day()
	assert(lawful.institutions.status == "upheld" and lawful.institutions.progress == 30)
	for i in range(30):
		lawful.advance_day()
	assert(lawful.institutions.status == "implemented" and lawful.institutions.progress == 60)
	assert(lawful.revoke_directive())
	assert(lawful.institutions.status == "revoked")
	assert(not lawful.revoke_directive())
	assert(lawful.issue_directive("override"))
	for i in range(10):
		lawful.advance_day()
	assert(lawful.institutions.status == "injunction" and lawful.institutions.progress == 9)
	var injunction_save = lawful
	assert(government.vote_procurement())
	assert(not government.vote_procurement())
	assert(not government.vote_procurement_repeal())
	for i in range(99):
		government.advance_day()
	assert(is_equal_approx(government.policy_annual_cost(), 0.0))
	government.advance_day()
	assert(government.politics.procurement_progress == 100)
	assert(is_equal_approx(government.policy_annual_cost(), 10000000.0))
	assert(is_equal_approx(government.annual_balance(), 90000000.0))
	assert(is_equal_approx(government.preview_annual_spending(1100000000.0).annual_balance, 90000000.0))
	government.set_income_tax(0.60)
	government.date = {"year": 2029, "month": 12, "day": 31}
	assert(government.next_election_year() == 2030)
	government.advance_day()
	assert(government.politics.election_count == 1)
	assert(government.next_election_year() == 2034)
	government.advance_day()
	assert(government.politics.election_count == 1)
	assert(government.politics.parties[0].seats == 8)
	assert(government.politics.parties[1].seats > 0)
	assert(government.politics.parties[0].seats + government.politics.parties[1].seats + government.politics.parties[2].seats == 100)
	var election_edges = World.new()
	for group in election_edges.politics.groups:
		group.approval = 100.0
		group.raw_approval = 100.0
	election_edges.politics.election()
	assert(election_edges.politics.parties[0].seats == 100)
	for group in election_edges.politics.groups:
		group.approval = 0.0
		group.raw_approval = 0.0
	election_edges.politics.election()
	assert(election_edges.politics.parties[0].seats == 0)
	assert(election_edges.politics.parties[1].seats == 50)
	assert(election_edges.politics.parties[2].seats == 50)
	var before_spending: Dictionary = high_tax_world.country.duplicate(true)
	var spending_prediction: Dictionary = high_tax_world.preview_annual_spending(1500000000.0)
	assert(high_tax_world.country == before_spending)
	assert(high_tax_world.preview_annual_spending(-1.0).is_empty())
	assert(high_tax_world.preview_annual_spending(NAN).is_empty())
	assert(high_tax_world.set_annual_spending(1500000000.0))
	assert(is_equal_approx(spending_prediction.annual_balance, high_tax_world.annual_balance()))
	assert(is_equal_approx(spending_prediction.daily_balance, high_tax_world.daily_balance()))
	high_tax_world.date.year = 2028
	assert(is_equal_approx(high_tax_world.preview_annual_spending(1500000000.0).daily_balance, 500000000.0 / 366.0))
	high_tax_world.date.year = 2026
	assert(is_equal_approx(high_tax_world.annual_balance(), 500000000.0))
	assert(not high_tax_world.set_annual_spending(-1.0))
	assert(not high_tax_world.set_annual_spending(NAN))
	assert(World.days_in_month(2028, 2) == 29)
	assert(World.days_in_month(2100, 2) == 28)
	var leap = World.new()
	leap.date = {"year": 2028, "month": 2, "day": 28}
	leap.advance_day()
	assert(leap.date.day == 29)
	leap.advance_day()
	assert(leap.date.month == 3 and leap.date.day == 1)
	var deficit = World.new()
	deficit.country.treasury = 1.0
	assert(deficit.set_annual_spending(2000000000.0))
	var first_flow: float = deficit.daily_balance()
	deficit.advance_day()
	assert(is_zero_approx(deficit.country.treasury))
	assert(absf(deficit.country.debt - (-first_flow - 1.0)) < 0.01)
	assert("borrowing began" in deficit.events[0])
	assert(deficit.debt_interest() > 0.0)
	var debt_before: float = deficit.country.debt
	assert(deficit.set_annual_spending(0.0))
	var repayment_flow: float = deficit.daily_balance()
	deficit.advance_day()
	assert(absf(deficit.country.debt - maxf(0.0, debt_before - repayment_flow)) < 0.01)
	assert(deficit.country.treasury >= 0.0)
	var repayment = World.new()
	repayment.country.debt = 10.0
	var repayment_net: float = repayment.daily_balance()
	var cash_before: float = repayment.country.treasury
	repayment.advance_day()
	assert(is_zero_approx(repayment.country.debt))
	assert(absf(repayment.country.treasury - (cash_before + repayment_net - 10.0)) < 0.01)
	var budget = World.new()
	var budget_before: Dictionary = budget.country.duplicate(true)
	var category_forecast: Dictionary = budget.preview_category_spending("Health", 400000000.0)
	assert(budget.country == budget_before)
	assert(not budget.set_category_spending("Unknown", 1.0))
	assert(not budget.set_category_spending("Health", NAN))
	assert(not budget.set_category_spending("Health", 10000000000.0))
	assert(budget.set_category_spending("Health", 400000000.0))
	assert(is_equal_approx(category_forecast.annual_balance, budget.annual_balance()))
	assert(is_equal_approx(budget.country.annual_spending, 1170000000.0))
	var stable_services = World.new()
	for i in range(180):
		stable_services.advance_day()
	assert(is_equal_approx(stable_services.services.levels.Health, 50.0))
	assert(is_equal_approx(stable_services.country.approval, 50.0))
	var service_cut = World.new()
	assert(service_cut.set_category_spending("Health", 0.0))
	assert(is_equal_approx(service_cut.services.levels.Health, 50.0))
	for i in range(180):
		service_cut.advance_day()
	assert(service_cut.services.levels.Health < 20.0)
	assert(service_cut.country.approval < 50.0)
	assert(service_cut.politics.groups[0].approval < service_cut.politics.groups[2].approval)
	var tax_after_services: Dictionary = service_cut.preview_income_tax(0.30)
	assert(service_cut.set_income_tax(0.30))
	assert(is_equal_approx(tax_after_services.approval, service_cut.country.approval))
	var service_increase = World.new()
	assert(service_increase.set_category_spending("Education", 550000000.0))
	for i in range(180):
		service_increase.advance_day()
	assert(service_increase.services.levels.Education > 80.0)
	assert(service_increase.country.approval > 50.0)
	for i in range(250):
		deficit.add_event("Test event")
	assert(deficit.events.size() == deficit.MAX_EVENTS)
	var long_run = World.new()
	for i in range(7305):
		long_run.advance_day()
	assert(long_run.date == {"year": 2046, "month": 1, "day": 1})
	assert(absf(long_run.country.treasury - 3000000000.0) < 10.0)
	var save_path := "res://tests/test_save.json"
	assert(injunction_save.save_game(save_path).is_empty())
	var injunction_reload = World.new()
	assert(injunction_reload.load_game(save_path).is_empty())
	assert(injunction_reload.institutions.status == "injunction")
	for i in range(20):
		injunction_reload.advance_day()
	assert(injunction_reload.institutions.status == "struck_down")
	assert(injunction_reload.institutions.progress == 9)
	assert(injunction_reload.issue_directive("reporting"))
	assert(injunction_reload.revoke_directive())
	assert(injunction_reload.institutions.progress == 0)
	var invalid_institutions: Dictionary = injunction_reload.institutions.export_state()
	invalid_institutions.status = "implemented"
	var invalid_institution_file := FileAccess.open(save_path, FileAccess.WRITE)
	invalid_institution_file.store_string(JSON.stringify({"version": 7, "date": injunction_reload.date, "country": injunction_reload.country, "events": injunction_reload.events, "politics": injunction_reload.politics.export_state(), "services": injunction_reload.services.export_state(), "institutions": invalid_institutions}))
	invalid_institution_file.close()
	var unchanged_institutions: Dictionary = injunction_reload.institutions.export_state()
	assert(not injunction_reload.load_game(save_path).is_empty())
	assert(injunction_reload.institutions.export_state() == unchanged_institutions)
	var old_institution_world = World.new()
	var v6_file := FileAccess.open(save_path, FileAccess.WRITE)
	v6_file.store_string(JSON.stringify({"version": 6, "date": old_institution_world.date, "country": old_institution_world.country, "events": old_institution_world.events, "politics": old_institution_world.politics.export_state(), "services": old_institution_world.services.export_state()}))
	v6_file.close()
	var v6 = World.new()
	assert(v6.load_game(save_path).is_empty())
	assert(v6.institutions.status == "none")
	assert(tax_world.save_game(save_path).is_empty())
	var tax_reload = World.new()
	assert(tax_reload.load_game(save_path).is_empty())
	assert(is_equal_approx(tax_reload.country.consumption_tax_rate, 0.10))
	assert(is_equal_approx(tax_reload.country.corporate_tax_rate, 0.20))
	assert(is_equal_approx(tax_reload.country.approval, tax_world.country.approval))
	var bad_tax_country: Dictionary = tax_world.country.duplicate(true)
	bad_tax_country.corporate_tax_rate = 0.8
	var bad_tax_file := FileAccess.open(save_path, FileAccess.WRITE)
	bad_tax_file.store_string(JSON.stringify({"version": 6, "date": tax_world.date, "country": bad_tax_country, "events": tax_world.events, "politics": tax_world.politics.export_state(), "services": tax_world.services.export_state()}))
	bad_tax_file.close()
	var tax_before_rejected_load: Dictionary = tax_reload.country.duplicate(true)
	assert(not tax_reload.load_game(save_path).is_empty())
	assert(tax_reload.country == tax_before_rejected_load)
	var old_tax_world = World.new()
	var v5_country: Dictionary = old_tax_world.country.duplicate(true)
	v5_country.erase("consumption_tax_rate")
	v5_country.erase("corporate_tax_rate")
	var v5_file := FileAccess.open(save_path, FileAccess.WRITE)
	v5_file.store_string(JSON.stringify({"version": 5, "date": old_tax_world.date, "country": v5_country, "events": old_tax_world.events, "politics": old_tax_world.politics.export_state(), "services": old_tax_world.services.export_state()}))
	v5_file.close()
	var v5 = World.new()
	assert(v5.load_game(save_path).is_empty())
	assert(is_zero_approx(v5.country.consumption_tax_rate) and is_zero_approx(v5.country.corporate_tax_rate))
	assert(service_cut.save_game(save_path).is_empty())
	var services_reload = World.new()
	assert(services_reload.load_game(save_path).is_empty())
	assert(is_equal_approx(services_reload.services.levels.Health, service_cut.services.levels.Health))
	for i in range(30):
		service_cut.advance_day()
		services_reload.advance_day()
	assert(is_equal_approx(services_reload.country.approval, service_cut.country.approval))
	assert(is_equal_approx(services_reload.services.levels.Health, service_cut.services.levels.Health))
	var saved_state: Dictionary = services_reload.country.duplicate(true)
	var invalid_services: Dictionary = service_cut.services.export_state()
	invalid_services.levels.Health = 101.0
	var broken_services := FileAccess.open(save_path, FileAccess.WRITE)
	broken_services.store_string(JSON.stringify({"version": 5, "date": service_cut.date, "country": service_cut.country, "events": service_cut.events, "politics": service_cut.politics.export_state(), "services": invalid_services}))
	broken_services.close()
	assert(not services_reload.load_game(save_path).is_empty())
	assert(services_reload.country == saved_state)
	var old_politics: Dictionary = stable_services.politics.export_state()
	for group in old_politics.groups:
		group.erase("service_bonus")
	var v4_file := FileAccess.open(save_path, FileAccess.WRITE)
	v4_file.store_string(JSON.stringify({"version": 4, "date": stable_services.date, "country": stable_services.country, "events": stable_services.events, "politics": old_politics}))
	v4_file.close()
	var v4 = World.new()
	assert(v4.load_game(save_path).is_empty())
	assert(is_equal_approx(v4.services.levels.Health, 50.0))
	assert(is_equal_approx(v4.country.approval, stable_services.country.approval))
	assert(budget.save_game(save_path).is_empty())
	var budget_reload = World.new()
	assert(budget_reload.load_game(save_path).is_empty())
	assert(is_equal_approx(budget_reload.country.spending_categories.Health, 400000000.0))
	assert(is_equal_approx(budget_reload.country.annual_spending, 1170000000.0))
	var legacy_country: Dictionary = budget.country.duplicate(true)
	legacy_country.erase("debt")
	legacy_country.erase("spending_categories")
	legacy_country.treasury = -12345.0
	var v3_file := FileAccess.open(save_path, FileAccess.WRITE)
	v3_file.store_string(JSON.stringify({"version": 3, "date": budget.date, "country": legacy_country, "events": budget.events, "politics": budget.politics.export_state()}))
	v3_file.close()
	var v3 = World.new()
	assert(v3.load_game(save_path).is_empty())
	assert(is_zero_approx(v3.country.treasury) and is_equal_approx(v3.country.debt, 12345.0))
	assert(is_equal_approx(v3.country.spending_categories.Health, 351000000.0))
	var election_save = World.new()
	election_save.date = {"year": 2029, "month": 12, "day": 31}
	assert(election_save.save_game(save_path).is_empty())
	var election_restored = World.new()
	assert(election_restored.load_game(save_path).is_empty())
	election_restored.advance_day()
	assert(election_restored.politics.election_count == 1)
	assert(election_restored.save_game(save_path).is_empty())
	var after_election = World.new()
	assert(after_election.load_game(save_path).is_empty())
	after_election.advance_day()
	assert(after_election.politics.election_count == 1)
	assert(cycle.set_income_tax(0.0))
	assert(cycle.save_game(save_path).is_empty())
	var cycle_restored = World.new()
	assert(cycle_restored.load_game(save_path).is_empty())
	assert(cycle_restored.set_income_tax(0.60))
	assert(is_equal_approx(cycle_restored.country.approval, 80.0))
	assert(government.save_game(save_path).is_empty())
	var restored_politics = World.new()
	assert(restored_politics.load_game(save_path).is_empty())
	assert(restored_politics.politics.procurement_progress == 100)
	assert(restored_politics.politics.election_count == 1)
	assert(restored_politics.politics.parties[0].seats == 8)
	assert(is_equal_approx(restored_politics.policy_annual_cost(), 10000000.0))
	assert(restored_politics.vote_procurement_repeal())
	assert(is_equal_approx(restored_politics.policy_annual_cost(), 0.0))
	assert(restored_politics.politics.procurement_progress == 0)
	assert(not restored_politics.vote_procurement())
	assert(not restored_politics.vote_procurement_repeal())
	assert(restored_politics.save_game(save_path).is_empty())
	var repeal_restored = World.new()
	assert(repeal_restored.load_game(save_path).is_empty())
	assert(not repeal_restored.politics.procurement_policy)
	assert(is_equal_approx(repeal_restored.policy_annual_cost(), 0.0))
	var mid_implementation = World.new()
	assert(mid_implementation.vote_procurement())
	mid_implementation.advance_day()
	mid_implementation.politics.parties[0].support = false
	mid_implementation.politics.parties[1].support = false
	assert(mid_implementation.vote_procurement_repeal())
	assert(mid_implementation.politics.procurement_progress == 0)
	assert(high_tax_world.save_game(save_path).is_empty())
	var restored = World.new()
	var load_error: String = restored.load_game(save_path)
	if not load_error.is_empty():
		push_error(load_error)
		quit(1)
		return
	assert(restored.date == high_tax_world.date)
	assert(is_equal_approx(restored.country.approval, 8.0))
	assert(is_equal_approx(restored.country.income_tax_rate, 0.60))
	assert(is_equal_approx(restored.country.annual_spending, 1500000000.0))
	assert(restored.events == high_tax_world.events)
	# Version 2 did not store raw approval; migrate its visible values.
	var v2_politics: Dictionary = high_tax_world.politics.export_state()
	for group in v2_politics.groups:
		group.erase("raw_approval")
	var v2_file := FileAccess.open(save_path, FileAccess.WRITE)
	v2_file.store_string(JSON.stringify({"version": 2, "date": high_tax_world.date, "country": high_tax_world.country, "events": high_tax_world.events, "politics": v2_politics}))
	v2_file.close()
	var v2 = World.new()
	assert(v2.load_game(save_path).is_empty())
	assert(is_equal_approx(v2.politics.approval(), high_tax_world.country.approval))
	assert(high_tax_world.set_income_tax(0.30))
	assert(high_tax_world.save_game(save_path).is_empty())
	var backup = World.new()
	assert(backup.load_game(save_path + ".bak").is_empty())
	assert(is_equal_approx(backup.country.income_tax_rate, 0.60))
	var legacy_file := FileAccess.open(save_path, FileAccess.WRITE)
	legacy_file.store_string(JSON.stringify({"version": 1, "date": backup.date, "country": backup.country, "events": backup.events}))
	legacy_file.close()
	var legacy = World.new()
	assert(legacy.load_game(save_path).is_empty())
	assert(is_equal_approx(legacy.politics.approval(), backup.country.approval))
	var original_state: Dictionary = restored.country.duplicate(true)
	var invalid_budget: Dictionary = budget.country.duplicate(true)
	invalid_budget.spending_categories.Health += 1.0
	var invalid_budget_file := FileAccess.open(save_path, FileAccess.WRITE)
	invalid_budget_file.store_string(JSON.stringify({"version": 4, "date": budget.date, "country": invalid_budget, "events": budget.events, "politics": budget.politics.export_state()}))
	invalid_budget_file.close()
	assert(not restored.load_game(save_path).is_empty())
	assert(restored.country == original_state)
	var invalid := FileAccess.open(save_path, FileAccess.WRITE)
	invalid.store_string("{bad json")
	invalid.close()
	assert(not restored.load_game(save_path).is_empty())
	assert(restored.country == original_state)
	# A damaged primary must never overwrite the valid backup on the next save.
	assert(restored.save_game(save_path).is_empty())
	var recovered_backup = World.new()
	assert(recovered_backup.load_game(save_path + ".bak").is_empty())
	assert(is_equal_approx(recovered_backup.country.income_tax_rate, 0.60))
	var recovered_primary = World.new()
	assert(recovered_primary.load_game(save_path).is_empty())
	assert(FileAccess.file_exists(save_path + ".invalid"))
	# An interrupted rotation artifact must not be silently overwritten.
	var interrupted := FileAccess.open(save_path + ".bak.previous", FileAccess.WRITE)
	interrupted.store_string("preserve me")
	interrupted.close()
	assert(not restored.save_game(save_path).is_empty())
	assert(FileAccess.get_file_as_string(save_path + ".bak.previous") == "preserve me")
	assert(recovered_backup.load_game(save_path + ".bak").is_empty())
	DirAccess.remove_absolute(ProjectSettings.globalize_path(save_path))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(save_path + ".bak"))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(save_path + ".invalid"))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(save_path + ".bak.previous"))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(save_path + ".tmp"))
	print("Simulation checks passed")
	quit(0)
