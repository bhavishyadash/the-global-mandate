extends SceneTree

func _initialize() -> void:
	call_deferred("run_checks")

func run_checks() -> void:
	assert(ProjectSettings.get_setting("display/window/size/mode") == 2)
	var screen = load("res://main.tscn").instantiate()
	root.add_child(screen)
	screen.set_process(false)
	assert(screen.dashboard_tabs.get_tab_count() == 8)
	assert(screen.dashboard_tabs.get_tab_title(7) == "Laws")
	assert("70/100" in screen.healthcare_summary.text)
	screen._vote_healthcare()
	assert(screen.world.healthcare.active and "active" in screen.healthcare_summary.text)
	screen.appropriation_picker.select(2)
	screen._refresh_healthcare()
	assert("APPROPRIATION VOTE: 70/100" in screen.healthcare_summary.text)
	screen._apply_healthcare_appropriation()
	assert(screen.world.healthcare.appropriation == 0.5 and "funded 50%" in screen.healthcare_summary.text)
	screen._repeal_healthcare()
	assert(not screen.world.healthcare.active)
	assert(screen.dashboard_tabs.get_tab_title(1) == "Budget & services")
	assert(screen.dashboard_tabs.get_tab_title(3) == "Government")
	assert(screen.dashboard_tabs.get_tab_title(4) == "Population")
	assert(screen.dashboard_tabs.get_tab_title(5) == "Diplomacy")
	assert("current test response" in screen.diplomacy_summary.text)
	screen._start_talks()
	assert(screen.world.diplomacy.active == "maritime")
	assert("day 0 / 30" in screen.diplomacy_summary.text)
	screen._cancel_talks()
	assert(screen.world.diplomacy.active.is_empty())
	screen.event_filter.select(5)
	screen._refresh_history()
	assert("diplomatic" in screen.history.text.to_lower())
	assert("Raw" in screen.population_summary.text and "placeholders" in screen.population_summary.text)
	screen.dashboard_tabs.current_tab = 3
	assert(screen.dashboard_tabs.current_tab == 3)
	screen._forecast_budget()
	assert("365-DAY FORECAST" in screen.forecast_label.text)
	assert(screen.forecast_current)
	assert(screen.world.date.day == 1)
	screen._compare_budget()
	assert("does not apply changes" in screen.comparison_label.text)
	assert(screen.comparison_current)
	screen.tax.value = 21
	assert(not screen.comparison_current and "OUT OF DATE" in screen.comparison_label.text)
	assert(screen.forecast_current)
	screen.tax.value = 20
	screen._advance_day()
	assert(not screen.forecast_current and "OUT OF DATE" in screen.forecast_label.text)
	screen.world.date.day = 1
	assert(is_equal_approx(screen.world.country.income_tax_rate, 0.20))
	assert(screen.world.date.day == 1)
	screen._advance_day()
	assert(screen.world.date.day == 2)
	screen.tax.value = 60
	assert("8.0%" in screen.tax_preview.text)
	assert(is_equal_approx(screen.world.country.income_tax_rate, 0.20))
	screen._apply_tax()
	assert(is_equal_approx(screen.world.country.approval, 8.0))
	screen.additional_tax.value = 10
	assert("CONSUMPTION" in screen.additional_tax_preview.text)
	assert(is_zero_approx(screen.world.country.consumption_tax_rate))
	screen._apply_additional_tax()
	assert(is_equal_approx(screen.world.country.consumption_tax_rate, 0.10))
	screen.spending.value = 1500
	assert("Annual balance" in screen.spending_preview.text)
	assert(is_equal_approx(screen.world.country.annual_spending, 1100000000.0))
	screen._apply_spending()
	assert(is_equal_approx(screen.world.country.annual_spending, 1500000000.0))
	screen.category_amount.value = 500
	screen._apply_category()
	assert(is_equal_approx(screen.world.country.spending_categories.Health, 500000000.0))
	assert(is_equal_approx(screen.world.country.annual_spending, 1550000000.0))
	assert("service" in screen.summary.text)
	assert("long-run service target" in screen.category_preview.text)
	screen._vote_policy()
	assert(screen.world.politics.procurement_policy)
	assert("Repeal support" in screen.politics_summary.text)
	screen._repeal_policy()
	assert(screen.world.politics.procurement_policy)
	screen._issue_directive()
	assert(screen.world.institutions.status == "under_review")
	assert("reporting" in screen.directive_summary.text.to_lower())
	screen._revoke_directive()
	assert(screen.world.institutions.status == "revoked")
	screen.world.date = {"year": 2029, "month": 12, "day": 31}
	screen._advance_day()
	assert(screen.world.politics.election_count == 1)
	assert("2034" in screen.politics_summary.text)
	screen._toggle_pause()
	assert(screen.running)
	screen._toggle_pause()
	assert(not screen.running)
	var before: Dictionary = screen.world.date.duplicate()
	screen._process(5.0)
	assert(screen.world.date == before)
	screen._toggle_pause()
	screen.speed = 30
	screen._process(2.0)
	assert(is_equal_approx(screen.elapsed, 30.0))
	screen._toggle_pause()
	screen._process(1.0)
	assert(is_equal_approx(screen.elapsed, 30.0))
	screen._toggle_pause()
	screen.speed = 1
	screen._process(0.0)
	assert(is_equal_approx(screen.elapsed, 0.0))
	var before_invalid: Dictionary = screen.world.country.duplicate(true)
	assert(not screen._start_scenario("res://data/scenarios/missing.json"))
	assert(screen.world.country == before_invalid)
	assert(screen._start_scenario("res://data/scenarios/coastal_test.json"))
	assert(screen.world.scenario_id == "coastal_test" and screen.world.country.population == 8000000)
	assert(screen.world.country.approval == 54.0 and screen.world.date.day == 1)
	assert(not screen.running and screen.elapsed == 0.0 and screen.scenario_picker.selected == 1)
	assert("Coastal Republic" in screen.summary.text)
	screen.queue_free()
	print("UI interaction checks passed")
	quit(0)
