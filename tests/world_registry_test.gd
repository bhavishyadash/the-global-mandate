extends SceneTree

const World = preload("res://simulation/world.gd")
const Registry = preload("res://simulation/world_registry.gd")
const SAVE := "res://tests/registry_test_save.json"

func _initialize() -> void:
	for suffix in ["", ".tmp", ".bak", ".invalid", ".bak.previous"]:
		assert(not FileAccess.file_exists(SAVE + suffix))
	var federal: Variant = World.Scenario.read_file(World.DEFAULT_SCENARIO)
	var coastal: Variant = World.Scenario.read_file("res://data/scenarios/coastal_test.json")
	var registry = Registry.new()
	assert(registry.initialize([federal, coastal]).is_empty())
	# A detached shared-world forecast includes talks, fees and year rollover.
	var forecast_federal: Dictionary = federal.duplicate(true)
	var forecast_coastal: Dictionary = coastal.duplicate(true)
	forecast_federal.date = {"year": 2026, "month": 12, "day": 15}
	forecast_coastal.date = forecast_federal.date.duplicate(true)
	var forecast_world = Registry.new()
	assert(forecast_world.initialize([forecast_federal, forecast_coastal]).is_empty())
	forecast_world._relations["coastal_republic|test_republic"] = 5.0
	assert(forecast_world.start_talks("test_republic", "coastal_republic", "cooperation"))
	var forecast_before: Dictionary = forecast_world.export_snapshot()
	var changes := {"income_tax": 0.3, "category_spending": {"category": "Health", "amount": 400000000.0}}
	var projected: Dictionary = forecast_world.forecast_fiscal("test_republic", 60, changes)
	assert(not projected.is_empty() and forecast_world.export_snapshot() == forecast_before)
	assert(forecast_world.forecast_fiscal("missing", 60).is_empty())
	assert(forecast_world.forecast_fiscal("test_republic", 0).is_empty())
	assert(forecast_world.forecast_fiscal("test_republic", 60, {"income_tax": NAN}).is_empty())
	assert(forecast_world.export_snapshot() == forecast_before)
	var forecast_actual = Registry.new()
	assert(forecast_actual.import_snapshot(forecast_before).is_empty())
	assert(forecast_actual.execute_country("test_republic", {"id": "set_income_tax", "args": {"rate": 0.3}}).ok)
	assert(forecast_actual.execute_country("test_republic", {"id": "set_category_spending", "args": {"category": "Health", "amount": 400000000.0}}).ok)
	for day in range(60):
		forecast_actual.advance_day()
	var forecast_country: Dictionary = forecast_actual.country_snapshot("test_republic")
	assert(forecast_actual.agreement_days("test_republic", "coastal_republic") > 0)
	assert(absf(projected.cash - forecast_country.country.treasury) < 0.01)
	assert(is_equal_approx(projected.approval, forecast_country.country.approval))
	assert(absf(projected.spending - forecast_country.previous_fiscal.spending - forecast_country.fiscal.spending) < 0.01)
	assert(absf(projected.revenue - forecast_country.previous_fiscal.revenue - forecast_country.fiscal.revenue) < 0.01)
	var without_talk = Registry.new()
	assert(without_talk.import_snapshot(forecast_before).is_empty())
	assert(without_talk.cancel_talks("test_republic", "coastal_republic"))
	var without_fee: Dictionary = without_talk.forecast_fiscal("test_republic", 60, changes)
	assert(absf(projected.spending - without_fee.spending - Registry.COOPERATION_COST) < 0.01)
	# Version 1 dialogue saves migrate without losing progress.
	var old_world = Registry.new()
	assert(old_world.initialize([federal, coastal]).is_empty())
	assert(old_world.start_dialogue("test_republic", "coastal_republic"))
	old_world.advance_day()
	var legacy: Dictionary = old_world.export_snapshot()
	legacy.version = 1
	legacy.erase("agreements")
	for key in legacy.talks:
		legacy.talks[key] = legacy.talks[key].progress
	var migrated = Registry.new()
	assert(migrated.import_snapshot(JSON.parse_string(JSON.stringify(legacy))).is_empty())
	assert(migrated.saved_controlled_id.is_empty())
	var invalid_control: Dictionary = migrated.export_snapshot()
	invalid_control["controlled_country"] = "missing_country"
	var previous_state: Dictionary = migrated.export_snapshot()
	assert(not migrated.import_snapshot(invalid_control).is_empty())
	assert(migrated.export_snapshot() == previous_state and migrated.saved_controlled_id.is_empty())
	assert(migrated.dialogue_progress("test_republic", "coastal_republic") == 1 and migrated.talk_kind("test_republic", "coastal_republic") == "dialogue")
	assert(migrated.cancel_talks("test_republic", "coastal_republic"))
	assert(not migrated.cancel_talks("test_republic", "coastal_republic"))
	# A proposal with inadequate relations is declined without a fee.
	var denied = Registry.new()
	assert(denied.initialize([federal, coastal]).is_empty())
	assert(denied.start_talks("test_republic", "coastal_republic", "cooperation"))
	for day in range(30):
		denied.advance_day()
	assert(denied.agreement_days("test_republic", "coastal_republic") == 0 and denied.relationship("test_republic", "coastal_republic") == 0.0)
	assert("declined" in denied.country_snapshot("test_republic").events[0])
	var insufficient = Registry.new()
	assert(insufficient.initialize([federal, coastal]).is_empty())
	insufficient._relations["coastal_republic|test_republic"] = 5.0
	assert(insufficient.start_talks("test_republic", "coastal_republic", "cooperation"))
	for day in range(29):
		insufficient.advance_day()
	insufficient._countries.test_republic.country.treasury = 0.0
	var coastal_cash: float = insufficient.country_snapshot("coastal_republic").country.treasury
	insufficient.advance_day()
	assert(insufficient.agreement_days("test_republic", "coastal_republic") == 0 and insufficient.relationship("test_republic", "coastal_republic") == 5.0)
	assert(insufficient.country_snapshot("coastal_republic").country.treasury > coastal_cash)
	# Accepted cooperation charges each country's cash and fiscal ledger once.
	var cooperation = Registry.new()
	var control = Registry.new()
	assert(cooperation.initialize([federal, coastal]).is_empty() and control.initialize([federal, coastal]).is_empty())
	cooperation._relations["coastal_republic|test_republic"] = 5.0
	assert(cooperation.start_talks("test_republic", "coastal_republic", "cooperation"))
	for day in range(30):
		cooperation.advance_day()
		control.advance_day()
	for id in ["test_republic", "coastal_republic"]:
		var accepted: Dictionary = cooperation.country_snapshot(id)
		var baseline: Dictionary = control.country_snapshot(id)
		assert(is_equal_approx(baseline.country.treasury - accepted.country.treasury, Registry.COOPERATION_COST))
		assert(is_equal_approx(accepted.fiscal.spending - baseline.fiscal.spending, Registry.COOPERATION_COST))
	assert(cooperation.relationship("test_republic", "coastal_republic") == 15.0 and cooperation.agreement_days("test_republic", "coastal_republic") == 365)
	assert(not cooperation.start_talks("test_republic", "coastal_republic", "cooperation"))
	var agreement_save: Dictionary = JSON.parse_string(JSON.stringify(cooperation.export_snapshot()))
	var agreement_restored = Registry.new()
	assert(agreement_restored.import_snapshot(agreement_save).is_empty())
	assert(agreement_restored.agreement_days("test_republic", "coastal_republic") == 365)
	var bad_agreement: Dictionary = agreement_save.duplicate(true)
	bad_agreement.agreements["coastal_republic|test_republic"] = 366
	var before_bad: Dictionary = agreement_restored.export_snapshot()
	assert(not agreement_restored.import_snapshot(bad_agreement).is_empty() and agreement_restored.export_snapshot() == before_bad)
	for day in range(365):
		agreement_restored.advance_day()
		control.advance_day()
	assert(agreement_restored.agreement_days("test_republic", "coastal_republic") == 0)
	for id in ["test_republic", "coastal_republic"]:
		assert(is_equal_approx(control.country_snapshot(id).country.treasury - agreement_restored.country_snapshot(id).country.treasury, Registry.COOPERATION_COST))
	assert(registry.country_ids() == ["coastal_republic", "test_republic"])
	var before: Dictionary = registry.export_snapshot()
	assert(not registry.initialize([federal, federal]).is_empty())
	assert(registry.export_snapshot() == before)
	var mismatched: Dictionary = coastal.duplicate(true)
	mismatched.date.day = 2
	assert(not registry.initialize([federal, mismatched]).is_empty())
	assert(registry.export_snapshot() == before)
	assert(registry.execute_country("test_republic", {"id": "set_income_tax", "args": {"rate": 0.3}}).ok)
	assert(registry.country_snapshot("test_republic").country.income_tax_rate == 0.3)
	assert(registry.country_snapshot("coastal_republic").country.income_tax_rate == 0.2)
	assert(not registry.execute_country("unknown", {"id": "vote_procurement", "args": {}}).ok)
	assert(not registry.start_dialogue("test_republic", "test_republic"))
	assert(not registry.start_dialogue("test_republic", "unknown"))
	assert(registry.start_dialogue("test_republic", "coastal_republic"))
	assert(not registry.start_dialogue("coastal_republic", "test_republic"))
	for day in range(29):
		registry.advance_day()
	assert(registry.dialogue_progress("test_republic", "coastal_republic") == 29)
	assert(registry.relationship("test_republic", "coastal_republic") == 0.0)
	var first_save_error: String = registry.save_game(SAVE)
	if not first_save_error.is_empty():
		push_error("Registry save failed: " + first_save_error)
	assert(first_save_error.is_empty())
	assert(registry.save_game(SAVE).is_empty())
	var primary := FileAccess.get_file_as_string(SAVE)
	var backup := FileAccess.get_file_as_string(SAVE + ".bak")
	registry._relations["coastal_republic|test_republic"] = 101.0
	assert(not registry.save_game(SAVE).is_empty())
	assert(FileAccess.get_file_as_string(SAVE) == primary)
	assert(FileAccess.get_file_as_string(SAVE + ".bak") == backup)
	assert(not FileAccess.file_exists(SAVE + ".tmp"))
	registry._relations.erase("coastal_republic|test_republic")
	var file_restored = Registry.new()
	assert(file_restored.load_game(SAVE).is_empty())
	assert(file_restored.dialogue_progress("test_republic", "coastal_republic") == 29)
	assert(file_restored.load_game(SAVE + ".bak").is_empty())
	var pending_temp := FileAccess.open(SAVE + ".tmp", FileAccess.WRITE)
	pending_temp.store_string("preserve incomplete save")
	pending_temp.close()
	assert(not registry.save_game(SAVE).is_empty())
	assert(FileAccess.get_file_as_string(SAVE + ".tmp") == "preserve incomplete save")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(SAVE + ".tmp"))
	var encoded: String = JSON.stringify(registry.export_snapshot())
	var restored = Registry.new()
	assert(restored.import_snapshot(JSON.parse_string(encoded)).is_empty())
	registry.advance_day()
	restored.advance_day()
	assert(registry.relationship("test_republic", "coastal_republic") == 5.0)
	assert(restored.relationship("coastal_republic", "test_republic") == 5.0)
	assert(restored.dialogue_progress("test_republic", "coastal_republic") == -1)
	var a: Dictionary = restored.country_snapshot("test_republic")
	var b: Dictionary = restored.country_snapshot("coastal_republic")
	assert(a.date == b.date and "concluded" in a.events[0] and "concluded" in b.events[0])
	var detached: Dictionary = restored.export_snapshot()
	detached.countries.test_republic.country.treasury = -1.0
	assert(restored.country_snapshot("test_republic").country.treasury >= 0.0)
	var saved_before: Dictionary = restored.export_snapshot()
	assert(not restored.import_snapshot(detached).is_empty())
	assert(restored.export_snapshot() == saved_before)
	DirAccess.remove_absolute(ProjectSettings.globalize_path(SAVE))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(SAVE + ".bak"))
	detached = saved_before.duplicate(true)
	detached.relations["unknown|test_republic"] = 10.0
	assert(not restored.import_snapshot(detached).is_empty())
	assert(restored.export_snapshot() == saved_before)
	print("Multi-country registry checks passed")
	quit(0)
