extends SceneTree

const World = preload("res://simulation/world.gd")
const Decisions = preload("res://simulation/decisions.gd")

func _initialize() -> void:
	var world = World.new()
	var detached_snapshot: Dictionary = world.export_snapshot()
	detached_snapshot.country.treasury = -1.0
	assert(world.country.treasury >= 0.0)
	var live_before: Dictionary = world.export_snapshot()
	assert(not world.import_snapshot(detached_snapshot).is_empty())
	assert(world.export_snapshot() == live_before)
	var snapshot_world = World.new()
	assert(snapshot_world.import_snapshot(live_before).is_empty())
	var input_copy: Dictionary = live_before.duplicate(true)
	assert(snapshot_world.import_snapshot(input_copy).is_empty())
	input_copy.country.name = "Changed after import"
	assert(snapshot_world.country.name != input_copy.country.name)
	world.advance_day()
	snapshot_world.advance_day()
	assert(world.export_snapshot() == snapshot_world.export_snapshot())
	world = World.new()
	var rng_world = World.new()
	var rng_twin = World.new()
	for i in range(20):
		assert(rng_world.next_random_u32() == rng_twin.next_random_u32())
	var fraction: float = rng_world.next_random_fraction()
	assert(fraction >= 0.0 and fraction < 1.0)
	assert(rng_world.random_state == rng_twin.next_random_u32())
	var random_before: int = rng_world.random_state
	assert(not rng_world.forecast_fiscal(30).is_empty())
	assert(rng_world.random_state == random_before)
	var random_path := "res://tests/random_state_test.json"
	assert(not FileAccess.file_exists(random_path))
	assert(rng_world.save_game(random_path).is_empty())
	var rng_restored = World.new()
	assert(rng_restored.load_game(random_path).is_empty())
	assert(rng_world.next_random_u32() == rng_restored.next_random_u32())
	var random_file := FileAccess.open(random_path, FileAccess.READ)
	var random_save: Dictionary = JSON.parse_string(random_file.get_as_text())
	random_file.close()
	random_save.random_state = -1
	random_file = FileAccess.open(random_path, FileAccess.WRITE)
	random_file.store_string(JSON.stringify(random_save))
	random_file.close()
	var state_before_invalid: int = rng_restored.random_state
	assert(not rng_restored.load_game(random_path).is_empty())
	assert(rng_restored.random_state == state_before_invalid)
	random_save.version = 13
	random_save.erase("random_seed")
	random_save.erase("random_state")
	random_file = FileAccess.open(random_path, FileAccess.WRITE)
	random_file.store_string(JSON.stringify(random_save))
	random_file.close()
	assert(rng_restored.load_game(random_path).is_empty())
	assert(rng_restored.random_state == World.Scenario.DEFAULT_SEED)
	DirAccess.remove_absolute(ProjectSettings.globalize_path(random_path))
	var decision_world = World.new()
	var decision_before: Dictionary = decision_world.country.duplicate(true)
	var events_before: Array = decision_world.events.duplicate()
	assert(Decisions.execute(decision_world, {"id": "unknown", "args": {}}).code == "unknown_decision")
	assert(Decisions.execute(decision_world, {"id": "set_income_tax", "args": {"rate": NAN}}).code == "invalid_arguments")
	assert(Decisions.execute(decision_world, {"id": "set_income_tax", "args": {"rate": "0.3"}}).code == "invalid_arguments")
	assert(Decisions.execute(decision_world, {"id": "set_income_tax", "args": {"rate": 0.3, "extra": 1}}).code == "invalid_arguments")
	assert(Decisions.execute(decision_world, {"id": "set_income_tax", "args": {"rate": 0.9}}).code == "unavailable")
	assert(decision_world.country == decision_before and decision_world.events == events_before)
	assert(Decisions.execute(decision_world, {"id": "set_income_tax", "args": {"rate": 0.3}}).ok)
	assert(is_equal_approx(decision_world.country.income_tax_rate, 0.3))
	assert(Decisions.execute(decision_world, {"id": "start_talks", "args": {"partner": "maritime", "proposal": "dialogue"}}).ok)
	assert(decision_world.filtered_events("finance").size() == 1)
	assert(decision_world.filtered_events("diplomacy").size() == 1)
	var copied_events: Array = decision_world.filtered_events("finance")
	copied_events[0].text = "changed"
	assert(decision_world.filtered_events("finance")[0].text != "changed")
	assert(not Decisions.execute(decision_world, {"id": "start_talks", "args": {"partner": "northern", "proposal": "dialogue"}}).ok)
	var scenario_data: Variant = World.Scenario.read_file(World.DEFAULT_SCENARIO)
	assert(World.Scenario.validate(scenario_data).is_empty())
	assert(world.scenario_id == "test_republic" and world.country.id == "test_republic")
	assert(World.Scenario.read_file("res://data/scenarios/missing.json") == null)
	var invalid_scenario: Dictionary = scenario_data.duplicate(true)
	invalid_scenario.country.spending_categories.Health = -1.0
	var before_scenario: Dictionary = world.country.duplicate(true)
	assert(not world.apply_scenario(invalid_scenario).is_empty())
	assert(world.country == before_scenario and world.scenario_id == "test_republic")
	invalid_scenario = scenario_data.duplicate(true)
	invalid_scenario.date = {"year": 2027, "month": 2, "day": 29}
	assert(not world.apply_scenario(invalid_scenario).is_empty())
	invalid_scenario = scenario_data.duplicate(true)
	invalid_scenario.country.annual_revenue = 0.0
	assert(not world.apply_scenario(invalid_scenario).is_empty())
	invalid_scenario = scenario_data.duplicate(true)
	invalid_scenario.seed = -1
	assert(not world.apply_scenario(invalid_scenario).is_empty())
	invalid_scenario = scenario_data.duplicate(true)
	invalid_scenario.politics.parties[0].seats = 99
	assert(not world.apply_scenario(invalid_scenario).is_empty())
	invalid_scenario = scenario_data.duplicate(true)
	invalid_scenario.services.levels.Health = 90.0
	assert(not world.apply_scenario(invalid_scenario).is_empty())
	assert(world.country == before_scenario)
	var v1_scenario: Dictionary = scenario_data.duplicate(true)
	v1_scenario.version = 1
	for field in ["politics", "services", "institutions", "diplomacy"]:
		v1_scenario.erase(field)
	assert(World.Scenario.validate(v1_scenario).is_empty())
	var alternate: Dictionary = scenario_data.duplicate(true)
	alternate.id = "custom_scenario"
	alternate.country.id = "custom_country"
	alternate.country.name = "Custom Test Country"
	alternate.date.month = 3
	alternate.politics.groups[0].approval = 60.0
	alternate.politics.groups[0].raw_approval = 60.0
	alternate.country.approval = 54.0
	alternate.politics.parties[0].seats = 50
	alternate.politics.parties[1].seats = 20
	alternate.diplomacy.relations.maritime = 80.0
	var scenario_world = World.new()
	assert(scenario_world.apply_scenario(alternate).is_empty())
	assert(scenario_world.country.name == "Custom Test Country" and scenario_world.fiscal.partial)
	assert(scenario_world.politics.groups[0].approval == 60.0 and scenario_world.politics.parties[0].seats == 50)
	assert(scenario_world.diplomacy.relations.maritime == 80.0 and scenario_world.country.approval == 54.0)
	alternate.country.name = "Changed externally"
	assert(scenario_world.country.name == "Custom Test Country")
	var scenario_path := "res://tests/scenario_test.json"
	assert(not FileAccess.file_exists(scenario_path))
	assert(scenario_world.save_game(scenario_path).is_empty())
	scenario_world.advance_day()
	assert(scenario_world.save_game(scenario_path).is_empty())
	var preserved_save := FileAccess.get_file_as_string(scenario_path)
	var preserved_backup := FileAccess.get_file_as_string(scenario_path + ".bak")
	var original_spending: float = scenario_world.country.spending_categories.Health
	scenario_world.country.spending_categories.Health = -1.0
	assert(not scenario_world.save_game(scenario_path).is_empty())
	assert(FileAccess.get_file_as_string(scenario_path) == preserved_save)
	assert(FileAccess.get_file_as_string(scenario_path + ".bak") == preserved_backup)
	assert(not FileAccess.file_exists(scenario_path + ".tmp"))
	scenario_world.country.spending_categories.Health = original_spending
	var scenario_restored = World.new()
	assert(scenario_restored.load_game(scenario_path).is_empty())
	assert(scenario_restored.scenario_id == "custom_scenario" and scenario_restored.country.id == "custom_country")
	assert(scenario_restored.politics.groups[0].approval == 60.0 and scenario_restored.diplomacy.relations.maritime == 80.0)
	assert(scenario_restored.event_records == scenario_world.event_records)
	var stored_scenario_file := FileAccess.open(scenario_path, FileAccess.READ)
	var stored_scenario: Dictionary = JSON.parse_string(stored_scenario_file.get_as_text())
	stored_scenario_file.close()
	stored_scenario.event_records[0].category = "invalid"
	stored_scenario_file = FileAccess.open(scenario_path, FileAccess.WRITE)
	stored_scenario_file.store_string(JSON.stringify(stored_scenario))
	stored_scenario_file.close()
	assert(not scenario_restored.load_game(scenario_path).is_empty())
	assert(scenario_restored.scenario_id == "custom_scenario")
	stored_scenario.version = 12
	stored_scenario.erase("event_records")
	stored_scenario_file = FileAccess.open(scenario_path, FileAccess.WRITE)
	stored_scenario_file.store_string(JSON.stringify(stored_scenario))
	stored_scenario_file.close()
	assert(scenario_restored.load_game(scenario_path).is_empty())
	assert(scenario_restored.event_records[0].category == "legacy" and scenario_restored.event_records[0].date == null)
	DirAccess.remove_absolute(ProjectSettings.globalize_path(scenario_path))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(scenario_path + ".bak"))
	var foreign = World.new()
	var declined = World.new()
	assert(not declined.diplomacy.will_accept("northern", "cooperation"))
	assert(declined.diplomacy.will_accept("maritime", "cooperation"))
	assert(declined.start_diplomatic_talks("northern", "cooperation"))
	for i in range(30):
		declined.advance_day()
	assert(declined.diplomacy.relations.northern == -10.0)
	assert("declined" in declined.events[0])
	assert(declined.start_diplomatic_talks("maritime", "cooperation"))
	for i in range(30):
		declined.advance_day()
	assert(declined.diplomacy.relations.maritime == 40.0)
	assert(declined.diplomacy.agreements.maritime == 365)
	assert(is_equal_approx(declined.policy_annual_cost(), 10000000.0))
	assert(is_equal_approx(declined.diplomacy.annual_partner_contribution(), 20000000.0))
	assert(is_equal_approx(declined.total_annual_revenue(), 1220000000.0))
	assert(is_equal_approx(declined.preview_income_tax(0.20).annual_revenue, declined.total_annual_revenue()))
	assert(is_equal_approx(declined.preview_annual_spending(1100000000.0).annual_balance, declined.annual_balance()))
	var agreement_path := "res://tests/agreement_test.json"
	assert(not FileAccess.file_exists(agreement_path))
	assert(declined.save_game(agreement_path).is_empty())
	var agreement_reload = World.new()
	assert(agreement_reload.load_game(agreement_path).is_empty())
	assert(agreement_reload.diplomacy.agreements.maritime == 365)
	var agreement_forecast: Dictionary = agreement_reload.forecast_fiscal(365)
	for i in range(365):
		agreement_reload.advance_day()
	assert(agreement_reload.diplomacy.agreements.maritime == 0)
	assert(agreement_reload.policy_annual_cost() == 0.0)
	assert(agreement_reload.diplomacy.annual_partner_contribution() == 0.0)
	assert(absf(agreement_forecast.debt - agreement_reload.country.debt) < 0.1)
	DirAccess.remove_absolute(ProjectSettings.globalize_path(agreement_path))
	var before_agreement_cash: float = declined.country.treasury
	var before_agreement_revenue: float = declined.fiscal.revenue
	var expected_agreement_flow: float = declined.daily_balance()
	declined.advance_day()
	assert(declined.country.treasury == before_agreement_cash and expected_agreement_flow > 0.0)
	assert(absf(declined.fiscal.revenue - before_agreement_revenue - declined.total_annual_revenue() / 365.0) < 0.01)
	assert(declined.diplomacy.agreements.maritime == 364)
	assert(declined.end_cooperation("maritime"))
	assert(declined.diplomacy.relations.maritime == 35.0 and declined.policy_annual_cost() == 0.0)
	assert(not declined.end_cooperation("maritime"))
	assert(not foreign.start_diplomatic_talks("unknown"))
	assert(foreign.start_diplomatic_talks("northern"))
	assert(not foreign.start_diplomatic_talks("maritime"))
	for i in range(29):
		foreign.advance_day()
	assert(foreign.diplomacy.progress == 29 and foreign.diplomacy.relations.northern == -10.0)
	var diplomatic_path := "res://tests/diplomacy_test.json"
	assert(not FileAccess.file_exists(diplomatic_path))
	assert(foreign.save_game(diplomatic_path).is_empty())
	var diplomatic_reload = World.new()
	assert(diplomatic_reload.load_game(diplomatic_path).is_empty())
	assert(diplomatic_reload.diplomacy.progress == 29)
	assert(diplomatic_reload.diplomacy.proposal == "dialogue")
	var old_diplomatic_file := FileAccess.open(diplomatic_path, FileAccess.READ)
	var old_diplomatic_data: Dictionary = JSON.parse_string(old_diplomatic_file.get_as_text())
	old_diplomatic_file.close()
	old_diplomatic_data.version = 9
	old_diplomatic_data.diplomacy.erase("proposal")
	old_diplomatic_file = FileAccess.open(diplomatic_path, FileAccess.WRITE)
	old_diplomatic_file.store_string(JSON.stringify(old_diplomatic_data))
	old_diplomatic_file.close()
	assert(diplomatic_reload.load_game(diplomatic_path).is_empty())
	assert(diplomatic_reload.diplomacy.proposal == "dialogue")
	diplomatic_reload.advance_day()
	assert(diplomatic_reload.diplomacy.relations.northern == -5.0)
	var invalid_diplomacy: Dictionary = foreign.diplomacy.export_state()
	invalid_diplomacy.relations.northern = 101.0
	assert(not diplomatic_reload.diplomacy.import_state(invalid_diplomacy))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(diplomatic_path))
	foreign.advance_day()
	assert(foreign.diplomacy.active.is_empty() and foreign.diplomacy.relations.northern == -5.0)
	assert(not foreign.start_diplomatic_talks("northern"))
	for i in range(90):
		foreign.advance_day()
	assert(foreign.start_diplomatic_talks("northern"))
	assert(foreign.cancel_diplomatic_talks())
	assert(foreign.diplomacy.cooldowns.northern == 90)
	var initial_treasury: float = world.country.treasury
	var trend = World.new()
	assert(trend.indicator_history.size() == 1 and trend.indicator_history[0].date == trend.date)
	assert(trend.set_income_tax(0.3))
	for day in range(31):
		trend.advance_day()
	assert(trend.indicator_history.size() == 2 and trend.indicator_history[1].date == {"year": 2026, "month": 2, "day": 1})
	assert(is_equal_approx(trend.indicator_history[1].approval, trend.country.approval))
	var trend_save: Dictionary = JSON.parse_string(JSON.stringify(trend.export_snapshot()))
	var trend_loaded = World.new()
	var trend_load_error: String = trend_loaded.import_snapshot(trend_save)
	assert(trend_load_error.is_empty())
	assert(trend_loaded.indicator_history.size() == trend.indicator_history.size())
	assert(is_equal_approx(trend_loaded.indicator_history[1].cash, trend.indicator_history[1].cash))
	assert(trend_loaded.indicator_history[1].population == trend.country.population)
	var v24_history: Dictionary = trend_save.duplicate(true)
	v24_history.version = 24
	for sample in v24_history.indicator_history:
		sample.erase("population")
	var v24_loaded = World.new()
	assert(v24_loaded.import_snapshot(v24_history).is_empty())
	assert(not v24_loaded.indicator_history[0].has("population"))
	for day in range(28):
		v24_loaded.advance_day()
	assert(not v24_loaded.indicator_history[1].has("population") and v24_loaded.indicator_history[2].population == v24_loaded.country.population)
	assert(World.new().import_snapshot(JSON.parse_string(JSON.stringify(v24_loaded.export_snapshot()))).is_empty())
	var gap_history: Dictionary = v24_loaded.export_snapshot()
	gap_history.indicator_history[0].population = 100
	assert(not World.new().import_snapshot(gap_history).is_empty())
	var bad_population: Dictionary = v24_loaded.export_snapshot()
	bad_population.indicator_history[2].population = -1
	assert(not World.new().import_snapshot(bad_population).is_empty())
	var old_trend: Dictionary = trend_save.duplicate(true)
	old_trend.version = 22
	old_trend.erase("indicator_history")
	assert(trend_loaded.import_snapshot(old_trend).is_empty() and trend_loaded.indicator_history.is_empty())
	for day in range(28):
		trend_loaded.advance_day()
	assert(trend_loaded.indicator_history.size() == 1 and trend_loaded.indicator_history[0].date.month == 3)
	var bad_trend: Dictionary = trend_save.duplicate(true)
	bad_trend.indicator_history[1].date = bad_trend.indicator_history[0].date.duplicate(true)
	var trend_before_bad: Dictionary = trend_loaded.export_snapshot()
	assert(not trend_loaded.import_snapshot(bad_trend).is_empty() and trend_loaded.export_snapshot() == trend_before_bad)
	bad_trend = trend_save.duplicate(true)
	bad_trend.indicator_history[0].approval = NAN
	assert(not trend_loaded.import_snapshot(bad_trend).is_empty())
	bad_trend = trend_save.duplicate(true)
	bad_trend.indicator_history[1].date.year = 2030
	assert(not trend_loaded.import_snapshot(bad_trend).is_empty())
	bad_trend = trend_save.duplicate(true)
	while bad_trend.indicator_history.size() <= World.MAX_INDICATOR_SAMPLES:
		bad_trend.indicator_history.append(bad_trend.indicator_history[0].duplicate(true))
	assert(not trend_loaded.import_snapshot(bad_trend).is_empty())
	var forecast: Dictionary = world.forecast_fiscal(365)
	assert(not forecast.is_empty() and world.date == World.INITIAL_DATE)
	assert(world.fiscal.days == 0 and world.politics.election_count == 0)
	assert(world.forecast_fiscal(0).is_empty() and world.forecast_fiscal(367).is_empty())
	var scenario: Dictionary = world.forecast_fiscal(30, {"income_tax": 0.3, "consumption_tax": 0.1, "spending": 1200000000.0})
	assert(not scenario.is_empty() and world.country.income_tax_rate == 0.2)
	assert(world.forecast_fiscal(30, {"income_tax": NAN}).is_empty())
	assert(world.forecast_fiscal(30, {"unknown": 1}).is_empty())
	var before_category_forecast: Dictionary = world.export_snapshot()
	var category_projection: Dictionary = world.forecast_fiscal(30, {"category_spending": {"category": "Health", "amount": 400000000.0}})
	assert(not category_projection.is_empty() and world.export_snapshot() == before_category_forecast)
	var actual_category = World.new()
	assert(actual_category.set_category_spending("Health", 400000000.0))
	assert(is_equal_approx(actual_category.country.spending_categories.Education, world.country.spending_categories.Education))
	for i in range(30):
		actual_category.advance_day()
	assert(absf(category_projection.debt - actual_category.country.debt) < 0.01)
	assert(is_equal_approx(category_projection.approval, actual_category.country.approval))
	assert(world.forecast_fiscal(30, {"category_spending": {"category": "Missing", "amount": 1}}).is_empty())
	assert(world.forecast_fiscal(30, {"category_spending": {"category": "Health", "amount": NAN}}).is_empty())
	assert(world.forecast_fiscal(30, {"category_spending": {"category": "Health", "amount": 100000000000.0}}).is_empty())
	assert(world.forecast_fiscal(30, {"spending": 1000000000.0, "category_spending": {"category": "Health", "amount": 1}}).is_empty())
	var scenario_actual = World.new()
	assert(scenario_actual.set_income_tax(0.3))
	assert(scenario_actual.set_additional_tax("consumption", 0.1))
	assert(scenario_actual.set_annual_spending(1200000000.0))
	for i in range(30):
		scenario_actual.advance_day()
	assert(absf(scenario.debt - scenario_actual.country.debt) < 0.01)
	assert(is_equal_approx(scenario.approval, scenario_actual.country.approval))
	for i in range(365):
		world.advance_day()
	assert(absf(forecast.debt - world.country.debt) < 0.01)
	assert(absf(forecast.revenue - world.previous_fiscal.revenue) < 0.01)
	assert(forecast.end_date == world.date)
	assert(world.date == {"year": 2027, "month": 1, "day": 1})
	assert(world.country.treasury == initial_treasury and world.country.debt == 0.0)
	assert(world.previous_fiscal.days == 365 and world.fiscal.days == 0)
	assert(absf(world.previous_fiscal.revenue - 1200000000.0) < 1.0)
	assert(absf(world.previous_fiscal.spending - 1100000000.0) < 1.0)
	assert(not world.previous_fiscal.partial)
	var ledger_world = World.new()
	ledger_world.country.treasury = 0.0
	assert(ledger_world.set_annual_spending(2000000000.0))
	ledger_world.advance_day()
	assert(ledger_world.fiscal.borrowed > 0.0)
	var deficit_forecast: Dictionary = ledger_world.forecast_fiscal(30)
	assert(deficit_forecast.debt > ledger_world.country.debt)
	assert(is_equal_approx(ledger_world.country.debt, ledger_world.fiscal.borrowed))
	assert(ledger_world.set_annual_spending(0.0))
	ledger_world.advance_day()
	assert(ledger_world.fiscal.interest > 0.0 and ledger_world.fiscal.repaid > 0.0)
	var accounting_balance: float = ledger_world.fiscal.revenue - ledger_world.fiscal.spending - ledger_world.fiscal.policy - ledger_world.fiscal.interest
	assert(absf(ledger_world.country.debt - ledger_world.fiscal.borrowed + ledger_world.fiscal.repaid) < 0.01)
	var ledger_path := "res://tests/fiscal_test.json"
	assert(ledger_world.save_game(ledger_path).is_empty())
	var ledger_loaded = World.new()
	assert(ledger_loaded.load_game(ledger_path).is_empty())
	assert(ledger_loaded.fiscal.days == ledger_world.fiscal.days)
	assert(is_equal_approx(ledger_loaded.fiscal.revenue, ledger_world.fiscal.revenue))
	assert(is_equal_approx(ledger_loaded.fiscal.borrowed, ledger_world.fiscal.borrowed))
	ledger_loaded.advance_day()
	ledger_world.advance_day()
	assert(ledger_loaded.fiscal.days == ledger_world.fiscal.days)
	assert(is_equal_approx(ledger_loaded.fiscal.interest, ledger_world.fiscal.interest))
	var ledger_file := FileAccess.open(ledger_path, FileAccess.READ)
	var ledger_data: Dictionary = JSON.parse_string(ledger_file.get_as_text())
	ledger_file.close()
	ledger_data.fiscal.interest = -1.0
	ledger_file = FileAccess.open(ledger_path, FileAccess.WRITE)
	ledger_file.store_string(JSON.stringify(ledger_data))
	ledger_file.close()
	assert(not ledger_loaded.load_game(ledger_path).is_empty())
	ledger_data.version = 7
	ledger_file = FileAccess.open(ledger_path, FileAccess.WRITE)
	ledger_file.store_string(JSON.stringify(ledger_data))
	ledger_file.close()
	assert(ledger_loaded.load_game(ledger_path).is_empty())
	assert(ledger_loaded.fiscal.partial and ledger_loaded.fiscal.days == 0)
	DirAccess.remove_absolute(ProjectSettings.globalize_path(ledger_path))
