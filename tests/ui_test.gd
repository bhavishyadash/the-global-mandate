extends SceneTree

const World = preload("res://simulation/world.gd")

func _initialize() -> void:
	call_deferred("run_checks")

func run_checks() -> void:
	assert(ProjectSettings.get_setting("display/window/size/mode") == 2)
	var screen = load("res://main.tscn").instantiate()
	root.add_child(screen)
	screen.set_process(false)
	assert(screen.dashboard_tabs.get_tab_count() == 10)
	assert(screen.dashboard_tabs.get_tab_title(9) == "Executive Orders")
	assert("HOUSE: 435" in screen.congress_summary.text and "SENATE: 100" in screen.congress_summary.text)
	assert(not screen.congress_buttons.introduce_congress_bill.disabled and screen.congress_buttons.congress_vote.disabled and screen.congress_buttons.sign.disabled)
	assert("House 280/435" in screen.congress_summary.text and "selected proposal" in screen.congress_summary.text)
	screen._request_congress_action("introduce_congress_bill")
	assert(screen.world.congress.stage == "idle" and not screen.pending_decision.is_empty())
	screen._confirm_review()
	screen.review_dialog.hide()
	assert(screen.world.congress.stage == "house")
	assert(screen.congress_buttons.introduce_congress_bill.disabled and not screen.congress_buttons.congress_vote.disabled and screen.congress_buttons.veto.disabled)
	screen._request_congress_action("congress_vote")
	assert("280 of 435" in screen.review_dialog.dialog_text)
	assert("218 votes required" in screen.review_dialog.dialog_text and "passes" in screen.review_dialog.dialog_text)
	screen._cancel_review()
	screen.review_dialog.hide()
	assert(screen.world.congress.stage == "house")
	screen._request_congress_action("congress_vote")
	screen._confirm_review()
	screen.review_dialog.hide()
	assert("House: 280/435 — passed" in screen.congress_summary.text)
	screen._request_congress_action("congress_vote")
	screen._confirm_review()
	screen.review_dialog.hide()
	assert(not screen.congress_buttons.sign.disabled and not screen.congress_buttons.veto.disabled and screen.congress_buttons.congress_vote.disabled)
	screen._request_congress_action("sign")
	assert("healthcare cost" in screen.review_dialog.dialog_text)
	screen._confirm_review()
	screen.review_dialog.hide()
	assert(screen.world.healthcare.active and "President: sign" in screen.congress_summary.text)
	assert(screen.world.apply_scenario(World.Scenario.read_file(World.DEFAULT_SCENARIO)).is_empty())
	screen._refresh()
	assert(screen.healthcare_panel.visible and not screen.procurement_panel.visible)
	screen.law_categories.current_tab = 1
	screen._refresh_law_catalog()
	assert(screen.procurement_panel.visible and not screen.healthcare_panel.visible)
	screen.law_search.text = "missing"
	screen._refresh_law_catalog()
	assert(not screen.procurement_panel.visible and "No implemented laws" in screen.law_catalog_note.text)
	screen.law_search.text = ""
	screen.law_categories.current_tab = 2
	screen._refresh_law_catalog()
	assert(not screen.healthcare_panel.visible and not screen.procurement_panel.visible)
	screen.law_categories.current_tab = 0
	screen._refresh_law_catalog()
	assert(screen._request_review("vote_healthcare", {"funding": 100000000.0}))
	assert(not screen.world.healthcare.active and "70 / 100" in screen.review_dialog.dialog_text)
	screen._cancel_review()
	screen.review_dialog.hide()
	assert(not screen.world.healthcare.active)
	assert(screen._request_review("vote_healthcare", {"funding": 100000000.0}))
	screen.world.date.day = 2
	screen._confirm_review()
	screen.review_dialog.hide()
	assert(not screen.world.healthcare.active and "State changed" in screen.status.text)
	screen.world.date.day = 1
	assert(screen._request_review("vote_healthcare", {"funding": 100000000.0}))
	screen._confirm_review()
	screen.review_dialog.hide()
	assert(screen.world.healthcare.active)
	assert(screen._request_review("repeal_healthcare", {}))
	screen._confirm_review()
	screen.review_dialog.hide()
	assert(not screen.world.healthcare.active)
	assert(screen._request_review("issue_directive", {"kind": "reporting"}))
	assert("Court review" in screen.review_dialog.dialog_text)
	screen._cancel_review()
	screen.review_dialog.hide()
	assert("2026-01-01" in screen.government_status.text and "Approval 50.0%" in screen.government_status.text)
	assert(is_equal_approx(screen.budget_chart.total, 1100000000.0))
	assert(screen.budget_rows.Health[0].text == "$330.0M")
	screen.category_amount.value = 500
	screen.budget_mode.select(1)
	screen._refresh_budget_breakdown()
	assert(is_equal_approx(screen.budget_chart.total, 1270000000.0))
	assert(screen.budget_rows.Health[1].text == "$500.0M")
	assert(screen.budget_rows.Health[2].text == "39.4%")
	assert(is_equal_approx(screen.world.country.spending_categories.Health, 330000000.0))
	screen.category_amount.value = 10000
	screen._refresh_budget_breakdown()
	assert(screen.budget_chart.caption == "Unavailable" and screen.budget_rows.Health[1].text == "—")
	assert(is_equal_approx(screen.world.country.spending_categories.Health, 330000000.0))
	screen.budget_mode.select(0)
	screen._category_selected(screen.category_picker.selected)
	assert(screen.dashboard_tabs.get_tab_title(8) == "World Map")
	assert(screen.world_map.load_error.is_empty() and screen.world_map.countries.size() >= 170)
	screen.world_map.size = Vector2(1000, 500)
	var usa_point: Vector2 = screen.world_map.unit_to_screen(Vector2(-100.0 / 360.0, -40.0 / 180.0))
	assert(screen.world_map.country_at(usa_point).id == "USA")
	screen.world_map.select_at(usa_point)
	assert(screen.world_map.selected_id == "USA" and "United States" in screen.map_selection.text)
	assert(screen.map_scenario_button.visible and screen.map_scenario_button.text == "Start US sandbox")
	assert("fictional test values" in screen.map_simulation.text)
	var before_start: Dictionary = screen.world.export_snapshot()
	screen._map_scenario_action()
	assert(screen.pending_scenario_index == 2 and "replaces" in screen.new_game_confirmation.dialog_text)
	screen.new_game_confirmation.canceled.emit()
	screen.new_game_confirmation.hide()
	assert(screen.pending_scenario_index == -1 and screen.world.export_snapshot() == before_start)
	screen._map_scenario_action()
	screen._confirm_new_scenario()
	screen.new_game_confirmation.hide()
	assert(screen.world.scenario_id == "usa_sandbox" and screen.world.country.id == "usa_sandbox")
	assert(screen.map_scenario_button.text == "Open government" and "ACTIVE US SANDBOX" in screen.map_simulation.text)
	assert(screen.world.set_income_tax(0.6))
	screen._refresh()
	assert("Approval: 8.0%" in screen.map_simulation.text)
	screen._map_scenario_action()
	assert(screen.dashboard_tabs.current_tab == 3 and screen.world.scenario_id == "usa_sandbox")
	var usa_saved: Dictionary = screen.world.export_snapshot()
	var usa_loaded = World.new()
	assert(usa_loaded.import_snapshot(JSON.parse_string(JSON.stringify(usa_saved))).is_empty())
	assert(usa_loaded.scenario_id == "usa_sandbox" and is_equal_approx(usa_loaded.country.income_tax_rate, 0.6))
	assert(screen._start_scenario(World.DEFAULT_SCENARIO))
	assert("US SANDBOX AVAILABLE" in screen.map_simulation.text)
	var france_point: Vector2 = screen.world_map.unit_to_screen(Vector2(2.0 / 360.0, -46.0 / 180.0))
	assert(screen.world_map.country_at(france_point).id == "FRA")
	# Real pointer event path: hovering, a slightly wobbly click and double click.
	screen.world_map.set_city_mode(3)
	screen.world_map._update_hover(france_point)
	assert(screen.world_map.hovered_id == "FRA" and "France" in screen.map_hover.text)
	var press := InputEventMouseButton.new()
	press.button_index = MOUSE_BUTTON_LEFT
	press.pressed = true
	press.position = france_point
	screen.world_map._gui_input(press)
	var motion := InputEventMouseMotion.new()
	motion.position = france_point + Vector2(2, 1)
	screen.world_map._gui_input(motion)
	var release := InputEventMouseButton.new()
	release.button_index = MOUSE_BUTTON_LEFT
	release.position = motion.position
	screen.world_map._gui_input(release)
	assert(screen.world_map.selected_id == "FRA" and "France" in screen.map_selection.text)
	assert(not screen.map_scenario_button.visible and "REFERENCE ONLY" in screen.map_simulation.text)
	assert(not screen.map_focus_button.disabled and not screen.map_clear_button.disabled)
	var double_click := InputEventMouseButton.new()
	double_click.button_index = MOUSE_BUTTON_LEFT
	double_click.pressed = true
	double_click.double_click = true
	double_click.position = france_point
	screen.world_map._gui_input(double_click)
	assert(screen.world_map.selected_id == "FRA" and screen.world_map.map_zoom > 1.0)
	assert(screen.map_zoom_label.text != "1.0×")
	screen.world_map.clear_selection()
	assert(screen.world_map.selected_id.is_empty() and screen.map_focus_button.disabled and "Select a country" in screen.map_selection.text)
	screen.world_map.reset_view()
	screen.world_map.set_city_mode(3)
	assert(screen.world_map._city_at(screen.world_map.unit_to_screen(Vector2(-77.0114 / 360.0, -38.9015 / 180.0))).is_empty())
	screen.world_map.set_city_mode(0)
	var sudan_point: Vector2 = screen.world_map.unit_to_screen(Vector2(30.0 / 360.0, -15.0 / 180.0))
	assert(screen.world_map.country_at(sudan_point).id == "SDN")
	var sudan: Dictionary = screen.world_map.countries.filter(func(c): return c.id == "SDN")[0]
	var sudan_screen := PackedVector2Array()
	for point in sudan.polygons[0][0]:
		sudan_screen.append(screen.world_map.unit_to_screen(point))
	assert(not screen.world_map._renderable_polygons(sudan_screen).is_empty())
	var ocean_point: Vector2 = screen.world_map.unit_to_screen(Vector2(0.0, 30.0 / 180.0))
	assert(screen.world_map.country_at(ocean_point).is_empty())
	screen.world_map.zoom_at(screen.world_map.size / 2.0, 3.0)
	assert(is_equal_approx(screen.world_map.map_zoom, 3.0))
	var city_point: Vector2 = screen.world_map.unit_to_screen(Vector2(-77.0114 / 360.0, -38.9015 / 180.0))
	screen.world_map.select_at(city_point)
	assert("Washington" in screen.map_selection.text and "National capital" in screen.map_selection.text)
	screen.world_map.reset_view()
	assert(is_equal_approx(screen.world_map.map_zoom, 1.0) and screen.world_map.pan == Vector2.ZERO)
	screen._search_map("france")
	assert(screen.map_results.item_count >= 1 and screen.map_results.get_item_text(0).contains("France"))
	screen._select_map_result(0)
	assert(screen.world_map.selected_id == "FRA" and screen.world_map.map_zoom > 1.0)
	assert("France" in screen.map_selection.text)
	screen._search_map("washington")
	assert(screen.map_results.item_count >= 1)
	screen._select_map_result(0)
	assert(screen.world_map.selected_id == "USA" and "Washington" in screen.map_selection.text)
	assert(screen.world_map.selected_city_name.contains("Washington"))
	screen._search_map("no such place 987654321")
	assert(screen.map_results.item_count == 0 and screen.map_search_status.text == "No matches.")
	screen._search_map("")
	assert(not screen.map_results.visible)
	assert(screen.dashboard_tabs.get_tab_title(7) == "Laws")
	assert(screen.diagnostic_steps.placeholder_text.contains("reproduced"))
	assert("70/100" in screen.healthcare_summary.text)
	screen._vote_healthcare()
	assert(screen.world.healthcare.active and "active" in screen.healthcare_summary.text)
	screen.appropriation_picker.select(2)
	screen._refresh_healthcare()
	assert("APPROPRIATION VOTE: 70/100" in screen.healthcare_summary.text)
	screen._apply_healthcare_appropriation()
	assert(screen.world.healthcare.appropriation == 0.5 and "funded 50%" in screen.healthcare_summary.text)
	screen._repeal_healthcare()
	assert(not screen.world.healthcare.active)
	assert(screen.dashboard_tabs.get_tab_title(1) == "Budget & services")
	assert(screen.dashboard_tabs.get_tab_title(3) == "Government")
	assert(screen.dashboard_tabs.get_tab_title(4) == "Population")
	assert(screen.dashboard_tabs.get_tab_title(5) == "Diplomacy")
	assert("current test response" in screen.diplomacy_summary.text)
	screen._start_talks()
	assert(screen.world.diplomacy.active == "maritime")
	assert("day 0 / 30" in screen.diplomacy_summary.text)
	screen._cancel_talks()
	assert(screen.world.diplomacy.active.is_empty())
	screen.event_filter.select(5)
	screen._refresh_history()
	assert("diplomatic" in screen.history.text.to_lower())
	assert("Raw" in screen.population_summary.text and "placeholders" in screen.population_summary.text)
	screen.dashboard_tabs.current_tab = 3
	assert(screen.dashboard_tabs.current_tab == 3)
	screen._forecast_budget()
	assert("365-DAY FORECAST" in screen.forecast_label.text)
	assert(screen.forecast_current)
	assert(screen.world.date.day == 1)
	screen._compare_budget()
	assert("does not apply changes" in screen.comparison_label.text)
	assert(screen.comparison_current)
	screen.tax.value = 21
	assert(not screen.comparison_current and "OUT OF DATE" in screen.comparison_label.text)
	assert(screen.forecast_current)
	screen.tax.value = 20
	screen._advance_day()
	assert(not screen.forecast_current and "OUT OF DATE" in screen.forecast_label.text)
	screen.world.date.day = 1
	assert(is_equal_approx(screen.world.country.income_tax_rate, 0.20))
	assert(screen.world.date.day == 1)
	screen._advance_day()
	assert(screen.world.date.day == 2)
	screen.tax.value = 60
	assert("8.0%" in screen.tax_preview.text)
	assert(is_equal_approx(screen.world.country.income_tax_rate, 0.20))
	screen._apply_tax()
	assert(is_equal_approx(screen.world.country.approval, 8.0))
	assert("Approval 8.0%" in screen.government_status.text)
	screen.additional_tax.value = 10
	assert("CONSUMPTION" in screen.additional_tax_preview.text)
	assert(is_zero_approx(screen.world.country.consumption_tax_rate))
	screen._apply_additional_tax()
	assert(is_equal_approx(screen.world.country.consumption_tax_rate, 0.10))
	screen.spending.value = 1500
	assert("Annual balance" in screen.spending_preview.text)
	assert(is_equal_approx(screen.world.country.annual_spending, 1100000000.0))
	screen._apply_spending()
	assert(is_equal_approx(screen.world.country.annual_spending, 1500000000.0))
	screen.category_amount.value = 500
	screen._apply_category()
	assert(is_equal_approx(screen.world.country.spending_categories.Health, 500000000.0))
	assert(is_equal_approx(screen.world.country.annual_spending, 1550000000.0))
	assert("service" in screen.summary.text)
	assert("long-run service target" in screen.category_preview.text)
	screen._vote_policy()
	assert(screen.world.politics.procurement_policy)
	assert("Repeal support" in screen.politics_summary.text)
	screen._repeal_policy()
	assert(screen.world.politics.procurement_policy)
	screen._issue_directive()
	assert(screen.world.institutions.status == "under_review")
	assert("reporting" in screen.directive_summary.text.to_lower())
	screen._revoke_directive()
	assert(screen.world.institutions.status == "revoked")
	screen.world.date = {"year": 2029, "month": 12, "day": 31}
	screen._advance_day()
	assert(screen.world.politics.election_count == 1)
	assert("2034" in screen.politics_summary.text)
	screen._toggle_pause()
	assert(screen.running)
	screen._toggle_pause()
	assert(not screen.running)
	var before: Dictionary = screen.world.date.duplicate()
	screen._process(5.0)
	assert(screen.world.date == before)
	screen._toggle_pause()
	screen.speed = 30
	screen.simulation_budget_usec = 10000000
	screen._process(2.0)
	assert(is_equal_approx(screen.elapsed, 30.0))
	screen._toggle_pause()
	screen._process(1.0)
	assert(is_equal_approx(screen.elapsed, 30.0))
	screen._toggle_pause()
	screen.speed = 1
	screen._process(0.0)
	assert(is_equal_approx(screen.elapsed, 0.0))
	screen.speed = 30
	screen.simulation_budget_usec = 0
	screen._process(1.0)
	assert(is_equal_approx(screen.elapsed, 29.0))
	assert("29 simulation days queued" in screen.speed_status.text)
	screen._toggle_pause()
	screen._process(1.0)
	assert(is_equal_approx(screen.elapsed, 29.0) and "Paused" in screen.speed_status.text)
	screen._toggle_pause()
	screen.simulation_budget_usec = 10000000
	screen._process(0.0)
	assert(is_zero_approx(screen.elapsed))
	var before_invalid: Dictionary = screen.world.country.duplicate(true)
	assert(not screen._start_scenario("res://data/scenarios/missing.json"))
	assert(screen.world.country == before_invalid)
	assert(screen._start_scenario("res://data/scenarios/coastal_test.json"))
	assert(screen.world.scenario_id == "coastal_test" and screen.world.country.population == 8000000)
	assert(screen.world.country.approval == 54.0 and screen.world.date.day == 1)
	assert(not screen.running and screen.elapsed == 0.0 and screen.scenario_picker.selected == 1)
	assert("Coastal Republic" in screen.summary.text)
	screen.queue_free()
	print("UI interaction checks passed")
	quit(0)
